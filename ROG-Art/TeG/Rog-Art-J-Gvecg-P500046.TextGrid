			intervals [40]:
				xmin = 807.282
				xmax = 811.825
				text = "izzivov pri digitalizaciji plačil je zagotovo tudi varnost ."
			intervals [41]:
				xmin = 811.825
				xmax = 817.741
				text = "kako ste v vašem primeru zadostili zahtevam regulatorjev , nadzora , varnosti ?"
			intervals [42]:
