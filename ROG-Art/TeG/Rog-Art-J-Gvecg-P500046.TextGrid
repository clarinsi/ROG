			intervals [29]:
				xmin = 756.562
				xmax = 763.086
				text = "vendar imajo pa to priložnost , da svojo podjetje , ne , spravijo na neko boljšo konkurenčni nivo ,"
			intervals [30]:
				xmin = 763.086
				xmax = 769.576
				text = "da to tudi dejansko na licu mesta omogočjo , ne , mi zdej recimo , tko kə səm prej omenju , mamo številne servisne dejavnosti ,"
			intervals [31]:
				xmin = 769.576
