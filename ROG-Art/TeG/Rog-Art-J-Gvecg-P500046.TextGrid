				text = ""
			intervals [39]:
				xmin = 804.954
				xmax = 807.282
				text = "eee , gospod Culiberg , edən izməd"
			intervals [40]:
				xmin = 807.282
				xmax = 811.825
				text = "izzivov pri digitalizaciji plačil je zagotovo tudi varnost ."
			intervals [41]:
				xmin = 811.825
				xmax = 817.741
				text = "kako ste v vašəm primeru zadostili zahtevam regulatorjəv , nadzora , varnosti ?"
			intervals [42]:
				xmin = 817.741
				xmax = 824.165
				text = ""
			intervals [43]:
				xmin = 824.165
				xmax = 833.857
				text = "eee , gospod Roljič , v zadnjič mesecih vlada , kot ste že rekli , povečano zanimanje na področju alternativnih digitalnih , zlati tudi kriptovalutnih plačil ,"
			intervals [44]:
