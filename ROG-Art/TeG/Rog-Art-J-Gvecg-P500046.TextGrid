				text = "eee , recimo , da , da , da ponudjo strankam , ki pa nedvoumno želijo plačevati s karticami , ne ,"
			intervals [37]:
				xmin = 800.792
				xmax = 803.416
				text = "da jim to ponudijo in to tud za njih lahko neka konkurenčna prednost ."
