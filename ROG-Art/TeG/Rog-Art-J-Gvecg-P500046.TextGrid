				xmax = 824.165
				text = ""
			intervals [43]:
				xmin = 824.165
				xmax = 833.857
				text = "eee , gospod Roljič , v zadnjič mesecih vlada , kot ste že rekli , povečano zanimanje na področju alternativnih digitalnih , zlasti tudi kriptovalutnih plačil ,"
			intervals [44]:
