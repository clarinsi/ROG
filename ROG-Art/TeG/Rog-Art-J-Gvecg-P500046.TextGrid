			intervals [1]:
				xmin = 619.097
				xmax = 628.594
				text = "ja , najlepša hvala za vprašanje , jaz bom vendarle uvodoma izkoristil , e , in na tem mestu čestital ekipi Eli Pos za lansiranje res , e , uporabnega produkta in storitve ,"
			intervals [2]:
				xmin = 628.594
				xmax = 632.853
				text = "za katerega verjamemo , da bo olajšala poslovanje marsikateremu ,"
			intervals [3]:
				xmin = 632.853
				xmax = 634.712
				text = "e , malemu obrtniku in podjetniku ."
			intervals [4]:
				xmin = 634.712
				xmax = 637.164
				text = "zdaj kaj se našega gledišča tiče ,"
			intervals [5]:
				xmin = 637.164
				xmax = 645.097
				text = "bi izpostavil ravno to , kar ste me pravzaprav vprašali , ne , Slovenija je tudi navidezno zelo pokritemu trgu glede možnosti plačila s karticami"
			intervals [6]:
				xmin = 645.097
				xmax = 646.829
				text = "še vedno ,"
			intervals [7]:
				xmin = 646.829
				xmax = 657.103
				text = "eee , na točki , kjer je izredno veliko , poleg tistih , ki pravzaprav , subjektov , ne , ki pravzaprav sploh ne prejemajo nobenega in ne omogočajo plačila niti s kreditnimi karci…"
			intervals [8]:
				xmin = 657.103
				xmax = 657.91
				text = "karticami ,"
			intervals [9]:
				xmin = 657.91
				xmax = 663.37
				text = "kaj šele s kakšnimi kriptovalutami . mi ocenjujemo , da je cirka trideset tisoč takih poslovni… …"
			intervals [10]:
				xmin = 663.37
				xmax = 672.08
				text = ""
			intervals [11]:
				xmin = 672.08
				xmax = 676.815
				text = "… kot pa pravilo , recimo , vse ostale storitve recimo , manjša obrtna dela servisna , dela"
			intervals [12]:
				xmin = 676.815
				xmax = 682.401
				text = "inštalacije , pleskarska dela , celo taksi je takšen , da prej izjema kot pravilo , da ga lahko s kratico plačaš ."
			intervals [13]:
				xmin = 682.401
				xmax = 684.908
				text = "recimo tudi šokirani boste , da je recimo več kot"
			intervals [14]:
				xmin = 684.908
				xmax = 690.382
				text = "sedemdeset procentov vseh slovenskih frizerjev še vedno ima vezano knjigo računov , a ne , sploh nimajo davčnih blagajn ."
			intervals [15]:
				xmin = 690.382
				xmax = 700.695
				text = ""
			intervals [16]:
				xmin = 700.695
				xmax = 705.67
				text = "… možnosti in jih seznaniti z rešitvami , ki so v slovenskem trgu in , veseli smo , da so plod slovenskega znanja ,"
			intervals [17]:
				xmin = 705.67
				xmax = 709.875
				text = "tako da potencial tega je res izredno velik , ne , in kdo si ne bi recimo pa želel ,"
			intervals [18]:
				xmin = 709.875
				xmax = 714.246
				text = "da tako malo se pošalim , recimo , svojega pleskarja doma , a ne , ko , ko"
			intervals [19]:
				xmin = 714.246
				xmax = 721.645
				text = "se vedno malo treseš , koliko bo prišel račun , ne , morda pa vendarle na licu mesta s plačilno kartico plačati , kot pa da ,"
			intervals [20]:
				xmin = 721.645
				xmax = 727.343
				text = "e , skačeš potem nekam na bankomat ali pa karkoli podobnega ali pa da plačuješ po predračunu . tako da potencial je velik ,"
			intervals [21]:
				xmin = 727.343
				xmax = 728.376
				text = "torej ,"
			intervals [22]:
				xmin = 728.376
