			intervals [1]:
				xmin = 3.065
				xmax = 6.318
				text = "najraje špilamo s kolegi zdaj v bistvu Counter-Strike ,"
			intervals [2]:
				xmin = 6.318
				xmax = 9.961
				text = "to nonstop nabijamo , včasih sem tudi Minecraft špilal ."
			intervals [3]:
				xmin = 9.961
				xmax = 12.492
				text = "samo to se tako bolj za otroke igra ."
			intervals [4]:
				xmin = 12.492
				xmax = 15.623
				text = "probal sti Fortnite , samo mi ni bilo neke ,"
			intervals [5]:
				xmin = 15.623
				xmax = 20.963
				text = "zdaj pa se dobimo vsak večer skoraj s kolegi pa se pogovarjamo po Discordu"
			intervals [6]:
				xmin = 20.963
				xmax = 23.003
				text = "pa špilamo lepo Counter-Strike ."
			intervals [7]:
				xmin = 23.003
				xmax = 26.347
				text = "pa ti kaj špilaš ? ali nič ?"
			intervals [8]:
				xmin = 26.347
				xmax = 37.239
				text = ""
			intervals [9]:
				xmin = 37.239
				xmax = 39.44
				text = "ja , saj , kako dolgo pa že delaš muziko ?"
			intervals [10]:
				xmin = 39.44
				xmax = 68.123
				text = ""
			intervals [11]:
				xmin = 68.123
				xmax = 71.61
				text = "tako da v bistvu , v bistvu veš dosti"
			intervals [12]:
				xmin = 71.61
				xmax = 72.998
