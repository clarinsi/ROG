	item [5]:
		class = "IntervalTier"
		name = "conversational-trs"
		xmin = 3.065
		xmax = 334.744
		intervals: size = 71
			intervals [1]:
				xmin = 3.065
				xmax = 6.318
				text = "najraj špilamo s kolegi zaj v bistvi Konter-strajk ,"
			intervals [2]:
				xmin = 6.318
				xmax = 9.961
				text = "to nonstop nabijamo , fčasi sən tuji majnkreft špilo ."
			intervals [3]:
				xmin = 9.961
				xmax = 12.492
				text = "samo to se tak bol za otroke igra ."
			intervals [4]:
				xmin = 12.492
				xmax = 15.623
				text = "probo sti fortnajt , samo mi ni blo neke ,"
			intervals [5]:
				xmin = 15.623
				xmax = 20.963
				text = "zaj pa se dobimo fsaki večer skoro s kolegi pa se pogovarjamo po diskorde"
			intervals [6]:
				xmin = 20.963
				xmax = 23.003
				text = "pa špilamo lepo konte-strajk ."
			intervals [7]:
				xmin = 23.003
				xmax = 26.347
				text = "pa ti kej špilaš ? al nič ?"
			intervals [8]:
				xmin = 26.347
				xmax = 37.239
				text = ""
			intervals [9]:
				xmin = 37.239
				xmax = 39.44
				text = "ja , sej , kak dugo pa že delaš muziko ?"
			intervals [10]:
				xmin = 39.44
				xmax = 68.123
				text = ""
			intervals [11]:
				xmin = 68.123
				xmax = 71.61
				text = "tak da v bistvi , v bistvi veš dosti"
			intervals [12]:
				xmin = 71.61
				xmax = 72.998
				text = "instrumentov špilat , ne ?"
			intervals [13]:
				xmin = 72.998
				xmax = 74.991
				text = "pa si kdaj študiro , da bi koga učil ?"
			intervals [14]:
				xmin = 74.991
				xmax = 77.671
				text = "glasbeno šolo maš nareto ?"
			intervals [15]:
				xmin = 77.671
				xmax = 99.411
				text = ""
			intervals [16]:
				xmin = 99.411
				xmax = 102.622
				text = "ja , se to , ja sən tuji fčasih špilo frajtonarco pa sən tuji šov"
			intervals [17]:
				xmin = 102.622
				xmax = 105.117
				text = "glasbeno šolo , ko še sploh ni blo to tak priznano ."
			intervals [18]:
				xmin = 105.117
				xmax = 108.657
				text = "enkrat sən prišo tja pa nisən več pol nikol šov , te pa sən se pač privat učil ."
			intervals [19]:
				xmin = 108.657
				xmax = 112.219
				text = "pa ze če bi začel učit , bi rabo v bistvi"
			intervals [20]:
				xmin = 112.219
				xmax = 114.216
				text = "zaklučeno glasbeno šolo al ?"
			intervals [21]:
				xmin = 114.216
				xmax = 115.706
				text = "bi lahko tak tuji ?"
			intervals [22]:
				xmin = 115.706
				xmax = 132.444
				text = ""
			intervals [23]:
				xmin = 132.444
				xmax = 136.413
				text = "ja , to je v bistvi so težki pogoji za , da priješ və zvezo ?"
			intervals [24]:
				xmin = 136.413
				xmax = 145.306
				text = ""
			intervals [25]:
				xmin = 145.306
				xmax = 149.318
				text = "ja , te v bistvu rajiš nekega dosežka , da priješ do tja , al kak ?"
			intervals [26]:
				xmin = 149.318
				xmax = 153.046
				text = ""
			intervals [27]:
				xmin = 153.046
				xmax = 154.834
				text = "ka pa da bi f kakem ansambli igral ?"
			intervals [28]:
