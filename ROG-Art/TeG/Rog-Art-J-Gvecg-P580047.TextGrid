	item [5]:
		class = "IntervalTier"
		name = "conversational-trs"
		xmin = 0.0
		xmax = 1733.57687
		intervals: size = 76
			intervals [1]:
				xmin = 0.0
				xmax = 35.09053
				text = "danəs je gostja našega radijskəga srečanja Tanja Fajon . že drugi mandat slovenska poslanka v Evropskəm parlamentu ,"
			intervals [2]:
				xmin = 35.09053
				xmax = 64.62079
				text = "nekdanja novinarka in dopisnica Erteve Slovenje iz Bruslja . lepo pozdravljəni v studiu Štajərskəga vala ."
			intervals [3]:
				xmin = 64.62079
				xmax = 70.96014
				text = "mmm , lepo pozdravljəni ."
			intervals [4]:
				xmin = 70.96014
				xmax = 100.63982
				text = "nazadnje ste delali za televizijo , sicər pa ste preizkusili vse medije , od tiska do radia ."
			intervals [5]:
				xmin = 100.63982
				xmax = 117.36865
				text = "radio je pravzaprav bil vaša prva postaja ,"
			intervals [6]:
				xmin = 117.36865
				xmax = 150.07926
				text = "začeli ste na takratnəm Ergeel-u , Radio glas Ljubljane in nadaljəvali na Radiu Slovenija ,"
			intervals [7]:
				xmin = 150.07926
				xmax = 159.70034
				text = "kasneje pa prehod na televizijo ."
			intervals [8]:
				xmin = 159.70034
				xmax = 190.94351
				text = "kako gledate na različne medije ? kje vam je bilo najlepše oziroma kateri vam je najljubši ?"
			intervals [9]:
				xmin = 190.94351
				xmax = 212.98181
				text = "ja , lahko priznam , da se še danəs verjetno najbolje počutim"
			intervals [10]:
				xmin = 212.98181
				xmax = 231.637
				text = "və radijskəm studiu , pred mikrofonom , to je bila tudi moja"
			intervals [11]:
				xmin = 231.637
				xmax = 243.26447
				text = "prva pot , kot ste omenili ,"
			intervals [12]:
				xmin = 243.26447
				xmax = 276.20987
				text = "kot mlada študentka səm začela kariero na Radiu glas Ljubljane , to je bilo še v času , ko se je ravno začenjala"
			intervals [13]:
				xmin = 276.20987
				xmax = 295.5054
				text = "in tudi , eem , na srečo kmalu končala vojna v Sloveniji ."
			intervals [14]:
				xmin = 295.5054
				xmax = 329.45399
				text = "potem me je res pot sočasno med študijəm novinarstva peljala od Radia glas , Radia študent ,"
			intervals [15]:
				xmin = 329.45399
				xmax = 336.7912
				text = "tudi časopisov ,"
			intervals [16]:
				xmin = 336.7912
				xmax = 354.77937
				text = "takrat Republike pa nekaj maləga na Delu"
			intervals [17]:
				xmin = 354.77937
				xmax = 370.45698
				text = "do Radia Slovenija in potem zelo kmalu"
			intervals [18]:
				xmin = 370.45698
				xmax = 391.84961
				text = "səm šla kot dopisnica za celo hišo Erteve"
			intervals [19]:
				xmin = 391.84961
				xmax = 428.48763
				text = "və Brusəlj . novinarstvo imam še danəs zelo rada . se mi zdi , da je en tak zelo odgovorən poklic . zelo lep poklic ,"
			intervals [20]:
				xmin = 428.48763
				xmax = 450.28581
				text = "ko lahko dejansko , eem , sporočaš ljudem tisto , kar se dogaja ."
			intervals [21]:
				xmin = 450.28581
				xmax = 498.8768
				text = "malce vam je bil pa tudi v zibəlko položən . ste iz novinarske družine , pravzaprav novinarsko-medijske . oče je bil novinar , mama filmska montažerka ."
			intervals [22]:
				xmin = 498.8768
				xmax = 522.13708
				text = "res je , res je , eem , da sta bila oba v medijskih vodah ."
			intervals [23]:
				xmin = 522.13708
				xmax = 559.73027
				text = "zej morəm rečt , ne , ko , ko səm bla mlada , pa səm opravila zelo kmalu neko avdicijo za televizijsko oddajo ,"
			intervals [24]:
				xmin = 559.73027
				xmax = 590.17302
				text = "sta mi , eem , prikrila , moja starša , kər si nista želela , da bi prehitro zašla v medijske vode ,"
			intervals [25]:
				xmin = 590.17302
				xmax = 614.94877
				text = "sta nekak vztrajala , da morəm u… najprej se učiti , da mi ne bi prehitro"
			intervals [26]:
				xmin = 614.94877
				xmax = 636.86434
				text = "kəkšna , eem , medijska ali zvezdništvo odpeljalo v napačno smer ."
			intervals [27]:
				xmin = 636.86434
				xmax = 654.61238
				text = "ampak radio se mi je zdela zmerej en tak medij ,"
			intervals [28]:
				xmin = 654.61238
				xmax = 659.61769
				text = "kjer lahko"
			intervals [29]:
				xmin = 659.61769
				xmax = 663.91863
				text = "takoj"
			intervals [30]:
				xmin = 663.91863
				xmax = 682.01885
				text = "prvi sežəš do ljudi in ta čar ima radio še vedno"
			intervals [31]:
				xmin = 682.01885
				xmax = 686.20773
				text = "danəs . res je ."
			intervals [32]:
				xmin = 686.20773
				xmax = 698.19273
				text = "in običajno nəm to ko neka kulisa ,"
			intervals [33]:
				xmin = 698.19273
				xmax = 717.79775
				text = "praktično se ne zavedamo , igra v ozadju in to səm jəz vəs čəs"
			intervals [34]:
				xmin = 717.79775
				xmax = 728.8756
				text = "in še danəs imam ta refleks , da"
			intervals [35]:
				xmin = 728.8756
				xmax = 751.0313
				text = "vsakič , ko je tista ura za poročila , kər səm delala tudi na nacionalnəm radiu ,"
			intervals [36]:
				xmin = 751.0313
				xmax = 772.51998
				text = "avtomatično preklopim , da poslušam poročila na radiu , če imam le to možnost ."
			intervals [37]:
				xmin = 772.51998
				xmax = 791.36193
				text = "e , sicer pa , Tanja , rojeni ste na dan Evrope , devetəga maja ."
			intervals [38]:
				xmin = 791.36193
				xmax = 812.7012
				text = "kar nekako naravno se zdi , da ste danəs članica Evropskəga parlamenta ."
			intervals [39]:
				xmin = 812.7012
				xmax = 817.68517
				text = ""
			intervals [40]:
				xmin = 817.68517
				xmax = 850.91872
				text = "večkrat mi ljudje rečejo , da , e , so me očitno že starši zaznamoval , ne vem , koko so lahko vplival na to ,"
			intervals [41]:
				xmin = 850.91872
				xmax = 864.80872
				text = "da səm se rodila devetəga maja , ampak"
			intervals [42]:
				xmin = 864.80872
				xmax = 876.4362
				text = "dan Evrope je res en tak , eem ,"
			intervals [43]:
				xmin = 876.4362
				xmax = 886.9911
				text = "lep praznik in vsakič mi"
			intervals [44]:
				xmin = 886.9911
				xmax = 917.55658
				text = "za rojstni dan veliko ljudi čestita in poveže to zgodbo z mojo evropsko kariero ."
			intervals [45]:
				xmin = 917.55658
				xmax = 942.16691
				text = "kər səm res že leta v evropski politiki z ene ali z druge strani ."
			intervals [46]:
				xmin = 942.16691
				xmax = 966.17959
				text = "e , mogoče , ja , me je zaznamoval boljce za šalo , no ,"
			intervals [47]:
				xmin = 966.17959
				xmax = 973.80495
				text = "ampak mi veliko pomeni ."
			intervals [48]:
				xmin = 973.80495
				xmax = 996.86246
				text = "toliko za uvod , po kratkəm predahu sva z gospo Tanjo Fajon nazaj ."
			intervals [49]:
				xmin = 996.86246
				xmax = 1069.16198
				text = ""
			intervals [50]:
				xmin = 1069.16198
				xmax = 1081.90471
				text = "magistrirali iz mednarodne politike"
			intervals [51]:
				xmin = 1081.90471
				xmax = 1088.4575
				text = "v Bruslju ."
			intervals [52]:
				xmin = 1088.4575
				xmax = 1143.36117
				text = "in se potem tudi vrnili v Brusəlj , ki vam je bil nekako domač . je vaše študijsko bivanje v Bruslju bilo odločilno , da so vas vaši takratni nadrejeni poslali za dopisnico v Brusəlj ?"
			intervals [53]:
				xmin = 1143.36117
				xmax = 1177.76333
				text = "ne , pravzaprav je bilo ravno nasprotno . jəz səm začela študirati že , ko səm bila və Bruslju ."
			intervals [54]:
				xmin = 1177.76333
				xmax = 1210.46861
				text = "leta dva tisoč ena je , eem , me Radiotelevizija Slovenija poslala za dopisnico v Brusəlj ."
			intervals [55]:
				xmin = 1210.46861
				xmax = 1244.17708
				text = "to je bilo zelo zanimivo obdobje , ko je Slovenija zadnja tri leta se priključəvala Evropski uniji"
			intervals [56]:
				xmin = 1244.17708
				xmax = 1271.45548
				text = "in je bilo res eno tako zelo vznemirljivo obdobje , tudi za Slovenijo , za novinarja ."
			intervals [57]:
				xmin = 1271.45548
				xmax = 1300.87368
				text = "in sočasno potem , ko so se ta leta nekoliko umirila , jəz səm bila dopisnica osəm let ."
			intervals [58]:
				xmin = 1300.87368
				xmax = 1321.29514
				text = "səm se potem v enəm obdobju odločila , da zdəj bi pa tudi še"
			intervals [59]:
				xmin = 1321.29514
				xmax = 1335.06241
				text = "investirala malce v svoje znanje"
			intervals [60]:
				xmin = 1335.06241
				xmax = 1351.14557
				text = "in izkoristila priložnost , da səm v tujini , tako da səm ,"
			intervals [61]:
				xmin = 1351.14557
				xmax = 1396.79101
				text = "eem , šele pozneje se təm odločila za en študij , tako bolj zame . želela səm si še malce bolj spoznati zunanjo politiko ."
			intervals [62]:
				xmin = 1396.79101
				xmax = 1421.75886
				text = "tako kot zdəj recimo še kər nadaljujəm nek študij zdəj bolj v Sloveniji ,"
			intervals [63]:
				xmin = 1421.75886
				xmax = 1440.64884
				text = "poslovni menedžment , eem , na Bledu ."
			intervals [64]:
				xmin = 1440.64884
				xmax = 1470.78742
				text = "še vedno me veseli , danəs morda bolj kot takrət , ko səm bila študentka , da se učim naprej ."
			intervals [65]:
				xmin = 1470.78742
				xmax = 1485.50986
				text = "hkrati pa se tudi večkrat vračate v Slovenijo ."
			intervals [66]:
				xmin = 1485.50986
				xmax = 1513.45529
				text = "vračam se , kər səm vəndarle və tej moji funkciji evropske poslanke ,"
			intervals [67]:
				xmin = 1513.45529
				xmax = 1547.35586
				text = "eem , izvoljəna v Sloveniji , kər je Slovenija moj dom , kər moram delovati v Sloveniji praktično vsak konəc tedna ,"
			intervals [68]:
				xmin = 1547.35586
				xmax = 1571.36854
				text = "in səm zelo vesela , da səm v teh šestih letih , odkər səm zamenjala ta ,"
			intervals [69]:
				xmin = 1571.36854
				xmax = 1579.35142
				text = "eem , profesionalni"
			intervals [70]:
				xmin = 1579.35142
				xmax = 1598.59892
				text = "vidik , da səm lahko skorajda vsak konəc tedna"
			intervals [71]:
				xmin = 1598.59892
				xmax = 1616.82188
				text = "və Sloveniji aktivna , da spet spoznavam , in"
			intervals [72]:
				xmin = 1616.82188
				xmax = 1653.27313
				text = "moram reči , da ko , ko si eno daljše obdobje v tujini , tako kot jəz , ko səm bila osəm let v tujini , in se potem vərnəš ,"
			intervals [73]:
				xmin = 1653.27313
				xmax = 1674.78315
				text = "veliko stvari se je spremenilo , ampak še vedno lahko danəs rečəm , da"
			intervals [74]:
				xmin = 1674.78315
				xmax = 1705.39665
				text = "nam marsikdo v Evropi zavida to Slovenijo našo , ki je izjemno lepa država ,"
			intervals [75]:
				xmin = 1705.39665
				xmax = 1715.35391
				text = "ima res , eem ,"
			intervals [76]:
				xmin = 1715.35391
				xmax = 1733.57687
				text = "en tak potencial , ki ga təžko najdəš , eem , drugje ."
