				xmax = 701.867
				text = "no , in , eee , torej kaj je zdej cilj , eee ,"
			intervals [114]:
				xmin = 701.867
				xmax = 704.286
				text = "tega . cilj je , da"
			intervals [115]:
				xmin = 704.286
				xmax = 705.593
				text = "se nardi"
			intervals [116]:
				xmin = 705.593
				xmax = 706.815
				text = "iz ,"
			intervals [117]:
				xmin = 706.815
				xmax = 707.918
				text = "hh , tko ,"
			intervals [118]:
				xmin = 707.918
				xmax = 711.525
				text = "da se regulira umetno inteligenco oziroma to tehnologijo ,"
			intervals [119]:
				xmin = 711.525
				xmax = 713.392
				text = "eee , tehnologije , ki"
			intervals [120]:
				xmin = 713.392
				xmax = 716.362
				text = "nekak spadajo v ta okvir umetne inteligence ,"
			intervals [121]:
				xmin = 716.362
				xmax = 720.139
				text = "eee , da se jih regulira na en ta način , da ne bojo delale škode ,"
			intervals [122]:
				xmin = 720.139
				xmax = 721.34
				text = "eee"
			intervals [123]:
				xmin = 721.34
				xmax = 723.326
				text = "eee , bodisi na"
			intervals [124]:
				xmin = 723.326
				xmax = 728.028
				text = "mikronivoju al pa tud na velik , eee , širšem nivoju , ne ."
