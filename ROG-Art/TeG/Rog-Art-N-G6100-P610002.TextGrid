				xmin = 20.025
				xmax = 26.049
				text = "e , da nekək vpliva na človeško nezavedno in , e , neka razumevanja nekih"
			intervals [6]:
				xmin = 26.049
				xmax = 30.329
				text = "stvari , ki so skozi filəm prikazana , predvsəm ta glavna poanta ,"
			intervals [7]:
				xmin = 30.329
				xmax = 34.646
				text = "da lahko še tako majhno bitje , e , premaga največje zlo ."
			intervals [8]:
				xmin = 34.646
				xmax = 39.164
				text = "in kljub temu , da imado škratje neke moči pa vilini moči ,"
			intervals [9]:
				xmin = 39.164
				xmax = 43.714
				text = "na koncu , e , v bistvu glavno vlogo odigra en majhni hobit ,"
			intervals [10]:
				xmin = 43.714
				xmax = 47.372
				text = "ki potuje skozi te dežele in nosi , e ,"
			intervals [11]:
				xmin = 47.372
				xmax = 48.573
				text = "prstan"
			intervals [12]:
				xmin = 48.573
				xmax = 51.775
				text = "və Goro pogube , kjer ga na koncu seveda"
			intervals [13]:
				xmin = 51.775
				xmax = 55.56
				text = "zopet ne sam , ampak s pomočjo , e , bitja Goluma ,"
			intervals [14]:
				xmin = 55.56
				xmax = 62.15
				text = "vseeno uspejo vržt v lavo , kjer se ta prstan kasneje izniči in tudi njegova moč ."
			intervals [15]:
				xmin = 62.15
				xmax = 66.331
				text = "aja , zdej səm jəz na kratko že opiskal zgodbo tega filma ,"
			intervals [16]:
				xmin = 66.331
				xmax = 71.543
				text = "e , provzaprov v vsaki , v vsakem filmu je ena zgodba , mogoče opišem"
			intervals [17]:
				xmin = 71.543
				xmax = 74.904
				text = "zgodbo , e , Kraljeva vrnitev , kjer"
			intervals [18]:
				xmin = 74.904
				xmax = 82.446
				text = "na prestol že več sto leti ni sedel pravi kralj , e , na prestolu vladajo sicer ljudje"
			intervals [19]:
				xmin = 82.446
				xmax = 85.093
				text = "kot neki namestniki kralja ,"
			intervals [20]:
				xmin = 85.093
				xmax = 90.681
				text = "kralj , ki je po krvni liniji kralj , pa se boji tega , e , svojega nasledstva , ker je njegov"
			intervals [21]:
				xmin = 90.681
				xmax = 94.862
				text = "prednik Ilzidur , e , bil , e , provzaprov"
			intervals [22]:
				xmin = 94.862
				xmax = 100.751
				text = "podvržen , e , slabosti , e , gospodarja prstana , se prav tega prstana ."
			intervals [23]:
				xmin = 100.751
				xmax = 111.281
				text = "in zato , e , tudi kasneje se on pa odloči , da preko bitk in vsəga , e , pride na prestol in provzaprov ta filəm je meni zelo všeč ."
			intervals [24]:
				xmin = 111.281
				xmax = 119.485
				text = "kateri izletniški kraj vam je všeč in zakaj ? e , za izletniški kraj bi izbral kraj Pəkəl pri Borovnici ."
			intervals [25]:
				xmin = 119.485
				xmax = 125.243
				text = "prvič zato , ker ni oddaljen in se mi zdi en , e , izmed prezrtih biserov"
			intervals [26]:
				xmin = 125.243
				xmax = 129.464
				text = "slovenske narave , e , kjer provzaprov v neki dolini"
			intervals [27]:
				xmin = 129.464
				xmax = 133.062
				text = "obstojajo zelo lepi slapovi , e , niso"
			intervals [28]:
				xmin = 133.062
				xmax = 137.818
				text = "tako znani , tako da ni velike gužve , ni tək velikega obiska ."
			intervals [29]:
				xmin = 137.818
				xmax = 140.434
				text = "in kadarkoli si tam , je lahko zanimivo ."
			intervals [30]:
				xmin = 140.434
				xmax = 147.837
				text = "si je pa te slapove vredno ogledati v različnih letnih časih in v vsakəm letnem času imajo nek svoj čar ."
			intervals [31]:
				xmin = 147.837
				xmax = 156.132
				text = "aha , glavne znamenitosti tega kraja bi lahko kər opisal , to je , e , Borovnica pri Vrhniki , ena od znamenitosti , ki jih sicer"
			intervals [32]:
				xmin = 156.132
				xmax = 165.001
				text = "je zgodovinska , e , v tem kraju , je ostal največji viadukt , e , železniški most v času med prvo in drugo svetovno vojno ."
			intervals [33]:
				xmin = 165.001
				xmax = 173.264
				text = "v drugi svetovni vojni so ga provzaprov zavezniki večkrat bombardiral , ker je to glavna povezava železniške proge Ljubljana-Trst ."
			intervals [34]:
				xmin = 173.264
				xmax = 177.584
				text = "po koncu vojne pa so se odločili , da ga ne bodo obnavljali ,"
			intervals [35]:
				xmin = 177.584
				xmax = 181.935
				text = "ampak so progo zgradili drugje , malo so jo podaljšali ."
			intervals [36]:
				xmin = 181.935
				xmax = 187.801
				text = "je pa provzaprov material iz tega železniškega mostu takrət prišel zelo prav in večina"
			intervals [37]:
				xmin = 187.801
				xmax = 193.797
				text = "po vojni zgrajenih hiš je zgrajena iz materiala tega železniškega mostu ."
			intervals [38]:
				xmin = 193.797
				xmax = 199.484
				text = "aha , pot do kraja Borovnice , e , je lahko iz večih smeri ,"
			intervals [39]:
				xmin = 199.484
				xmax = 201.735
				text = "e , če gledamo , e ,"
			intervals [40]:
				xmin = 201.735
				xmax = 204.462
				text = "da potujemo iz Ljubljane v Borovnico"
			intervals [41]:
				xmin = 204.462
				xmax = 208.298
				text = "lahko potujemo preko , e , Brezovice , Notranjih Goric ,"
			intervals [42]:
				xmin = 208.298
				xmax = 216.838
				text = "Podpeči ali pa , to je regionalna cesta , lahko pa potujəmo od Ljubljane proti Vrhniki po , e , avtocesti , izvoz Vrhnika ."
			intervals [43]:
				xmin = 216.838
				xmax = 220.484
				text = "na Vrhniki se orientiramo po tabli za muzej Bistra ."
			intervals [44]:
				xmin = 220.484
				xmax = 228.985
				text = "no , to je tudi ena od znamenitosti na tej poti , Tehniški muzej , e , Bistra , to je , e , mislim , da je to celo Tehniški muzej Slovenije , edən največjih ."
			intervals [45]:
				xmin = 228.985
				xmax = 233.495
				text = "e , zelo zanimivo za ogled in pa kasneje se pot nadaljuje do"
			intervals [46]:
				xmin = 233.495
				xmax = 237.41
				text = "vasi Borovnica , kjer səm že opisal , e , ta"
			intervals [47]:
				xmin = 237.41
				xmax = 241.156
				text = "še en stəbər tega viadukta stoji in pa"
			intervals [48]:
				xmin = 241.156
				xmax = 244.239
				text = "pot v Pəkəl , kjer so te slapovi zelo lepi …"
			intervals [49]:
				xmin = 244.239
				xmax = 246.855
				text = ""
			intervals [50]:
				xmin = 246.855
				xmax = 253.22
				text = "Kateri poklic mi je všeč in zakaj ? provzaprov mi je všeč poklic , ki ga upravljam , zdi se mi , da"
			intervals [51]:
				xmin = 253.22
				xmax = 254.714
				text = "lahko zə"
			intervals [52]:
				xmin = 254.714
				xmax = 258.451
				text = "učenjem nenasilne komunikacije pripomorem k"
			intervals [53]:
				xmin = 258.451
				xmax = 264.554
				text = "spremembami v tem svetu , in sicer , da se spremembe dogajajo skozi male ljudi , ki se naučijo"
			intervals [54]:
				xmin = 264.554
				xmax = 268.616
				text = "komunicirati , izražat svoja čustva , s tem , e ,"
			intervals [55]:
				xmin = 268.616
				xmax = 272.956
				text = "izboljša komunikacijo v medsebojnih odnosih znotraj družine ,"
			intervals [56]:
				xmin = 272.956
				xmax = 277.941
				text = "zgled so svojim otrokom , to se prenese potem v naslednjo generacijo provzaprov"
			intervals [57]:
				xmin = 277.941
				xmax = 283.906
				text = "se , e , svet po malih kamenčkih spreminja na … in provzaprov mi je zato moj poklic všeč ."
			intervals [58]:
				xmin = 283.906
				xmax = 292.102
				text = "poleg tega , da upravljam pogovore z ljudmi , e , je tukaj tudi , e , te prvi telefonski pogovori , samo naročanje ,"
			intervals [59]:
				xmin = 292.102
				xmax = 297.087
				text = "ljudje so zanimivi , kako se mogoče včasih opravičujejo , izogibajo ."
			intervals [60]:
				xmin = 297.087
				xmax = 301.07
				text = "pa vseeno najdemo neko skupno točko za sodelovanje"
			intervals [61]:
				xmin = 301.07
				xmax = 306.995
				text = "in , e , pravzaprav potem te ljudje , večina po končanem nekem programu , ki ga v službi"
			intervals [62]:
				xmin = 306.995
				xmax = 316.597
				text = "imamo , v smislu nenasilne komunikacije , večina ljudi pove , da jim je bilo težko pridət , da niso vedəl , kaj naj pričaku… , da pa so provzaprov sami pogovori in pa"
			intervals [63]:
				xmin = 316.597
				xmax = 325.633
				text = "delavnice ter praktična izvedba , ki jo delamo , presegla njihova pričakovanja in da so se naučili nekaj , kar jim bo koristilo naprej v življenju"
			intervals [64]:
				xmin = 325.633
				xmax = 328.348
				text = "tudi veči… , veliko jih"
			intervals [65]:
				xmin = 328.348
				xmax = 336.306
				text = "te stvari bile pomembne , da bi se to že tudi vneslo v šolski sistem , če ne v osnovni šoli pa sigurno v srednji šoli bi mogu obstojat"
			intervals [66]:
				xmin = 336.306
				xmax = 340.34
				text = "predmet Komunikacija in pa seveda tudi učenje o čustvih ."
