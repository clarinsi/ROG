	item [5]:
		class = "IntervalTier"
		name = "conversational-trs"
		xmin = 555.874
		xmax = 1089.334
		intervals: size = 167
			intervals [1]:
				xmin = 555.874
				xmax = 558.453
				text = "spoštovane , spoštovani ,"
			intervals [2]:
				xmin = 558.453
				xmax = 563.879
				text = "e , pridružujəm se pozdravu kolega , e , kolege Aleša Gabriča in se mu"
			intervals [3]:
				xmin = 563.879
				xmax = 566.943
				text = "zahvaljujəm za odlično sodelovanje"
			intervals [4]:
				xmin = 566.943
				xmax = 571.283
				text = "pri pripravi , e , pričujoče , e , konference ."
			intervals [5]:
				xmin = 571.283
				xmax = 571.942
				text = ""
			intervals [6]:
				xmin = 571.942
				xmax = 575.963
				text = "e , predvsəm pa se zahvaljujəm vsem , eee ,"
			intervals [7]:
				xmin = 575.963
				xmax = 578.339
				text = "ki ste poskrbeli za njen sklic ,"
			intervals [8]:
				xmin = 578.339
				xmax = 580.864
				text = "in vsem , ki ste se odzvali"
			intervals [9]:
				xmin = 580.864
				xmax = 583.222
				text = "na njihovo vabilo ."
			intervals [10]:
				xmin = 583.222
				xmax = 586.598
				text = "e , glede na izjemən odziv"
			intervals [11]:
				xmin = 586.598
				xmax = 592.08
				text = "obžalujəm , da je njen potek zožən na računalniške ekrane ,"
			intervals [12]:
				xmin = 592.08
				xmax = 594.616
				text = "ki , kot smo videli v zadnjəm letu ,"
			intervals [13]:
				xmin = 594.616
				xmax = 596.446
				text = "močno spreminjajo"
			intervals [14]:
				xmin = 596.446
				xmax = 598.528
				text = "dinamiko tovrstnih"
			intervals [15]:
				xmin = 598.528
				xmax = 599.439
				text = "dogodkov ."
			intervals [16]:
				xmin = 599.439
				xmax = 601.498
				text = ""
			intervals [17]:
				xmin = 601.498
				xmax = 605.139
				text = "žal mi je torəj za vse zamuj… zamujeno na konferenci ,"
			intervals [18]:
				xmin = 605.139
				xmax = 608.835
				text = "za vso formalno , neformalno komunikacijo ,"
			intervals [19]:
				xmin = 608.835
				xmax = 611.703
				text = "ki konferenco dela konferenco ."
			intervals [20]:
				xmin = 611.703
				xmax = 618.126
				text = "med drugim tudi neformalna srečanja strokovnjakinj in strokovnjakov za določeno področje ,"
			intervals [21]:
				xmin = 618.126
				xmax = 623.964
				text = "eem , vsakokratno temo in za z njo povezana raziskovalna vprašanja ."
			intervals [22]:
				xmin = 623.964
				xmax = 626.574
				text = ""
			intervals [23]:
				xmin = 626.574
				xmax = 627.894
				text = "če bi to"
			intervals [24]:
				xmin = 627.894
				xmax = 630.152
				text = "bilo mogoče ,"
			intervals [25]:
				xmin = 630.152
				xmax = 637.97
				text = "bi se ob današnji in jutrišnji konferenci , e , gotovo srečevali , e , tudi"
			intervals [26]:
				xmin = 637.97
				xmax = 639.344
				text = "vsi"
			intervals [27]:
				xmin = 639.344
				xmax = 645.19
				text = "tisti , ki so se zə ljubljanskim , e , kongresom v preteklosti že ukvarjali ."
			intervals [28]:
				xmin = 645.19
				xmax = 648.133
				text = "in teh , e ,"
			intervals [29]:
				xmin = 648.133
				xmax = 652.103
				text = "tudi po zaslugi kolegic in kolegov iz Zərəcə ,"
			intervals [30]:
				xmin = 652.103
				xmax = 654.394
				text = "e , ni tako malo ."
			intervals [31]:
				xmin = 654.394
				xmax = 656.723
				text = "e , spomnimo se samo , eem ,"
			intervals [32]:
				xmin = 656.723
				xmax = 663.784
				text = "kolegice Eve Holc oziroma njene , e , komentirane izdaje dnevnika , e , Henrika Koste ,"
			intervals [33]:
				xmin = 663.784
				xmax = 665.605
				text = "e , Staneta Granda"
			intervals [34]:
				xmin = 665.605
				xmax = 671.939
				text = "e , in njegovega gesla v kroniki devetnajstega stoletja , Igorja Grdine in razprave"
			intervals [35]:
				xmin = 671.939
				xmax = 673.714
				text = "Kongres zaseda ,"
			intervals [36]:
				xmin = 673.714
				xmax = 677.068
				text = "v zadnjəm času pa predvsəm Andreju ,"
			intervals [37]:
				xmin = 677.068
				xmax = 680.73
				text = "Andreja Rahtena , ki se lahko pohvali s tremi"
			intervals [38]:
				xmin = 680.73
				xmax = 682.749
				text = "tehtnimi deli ,"
			intervals [39]:
				xmin = 682.749
				xmax = 685.666
				text = "krona , e , katerih je študija"
			intervals [40]:
				xmin = 685.666
				xmax = 687.398
				text = "Šenkov Ljubljanski"
			intervals [41]:
				xmin = 687.398
				xmax = 689.861
				text = "kongres , e , študija , ki je"
			intervals [42]:
				xmin = 689.861
				xmax = 692.275
				text = "izšla , kot vemo , v knjigi ,"
			intervals [43]:
				xmin = 692.275
				xmax = 694.071
				text = "ki jo je uredil skupaj zə"
			intervals [44]:
				xmin = 694.071
				xmax = 699.472
				text = "Gregorjəm Antoličičəm , še enim kolegom iz Zərəcə Sazu , in Oskarjəm"
			intervals [45]:
				xmin = 699.472
				xmax = 701.317
				text = "Mulejəm ."
			intervals [46]:
				xmin = 701.317
				xmax = 703.172
				text = "və ta okvir"
			intervals [47]:
				xmin = 703.172
				xmax = 705.413
				text = "nedvoumno sodijo tudi ,"
			intervals [48]:
				xmin = 705.413
				xmax = 706.146
				text = "eem ,"
			intervals [49]:
				xmin = 706.146
				xmax = 711.518
				text = "filozofske refleksije idejnega sveta pred in po francoski"
			intervals [50]:
				xmin = 711.518
				xmax = 718.702
				text = "revoluciji , med katerimi je kar nekaj izšlo və našəm , e , Filozofskəm vestniku ."
			intervals [51]:
				xmin = 718.702
				xmax = 720.418
				text = "oboje skupaj"
			intervals [52]:
				xmin = 720.418
				xmax = 723.078
				text = "namrəč pokaže ,"
			intervals [53]:
				xmin = 723.078
				xmax = 729.258
				text = "kako zelo so se spremenili idejni horizonti postrazsvetljenske"
			intervals [54]:
				xmin = 729.258
				xmax = 731.072
				text = "Evrope ."
			intervals [55]:
				xmin = 731.072
				xmax = 733.166
				text = "kako zelo so se"
			intervals [56]:
				xmin = 733.166
				xmax = 736.782
				text = "demokratizirali pojmi , ki so bili nekoč"
			intervals [57]:
				xmin = 736.782
				xmax = 739.345
				text = "vezani na posamezno skupino ali"
			intervals [58]:
				xmin = 739.345
				xmax = 742.104
				text = "posamezno razmerje ."
			intervals [59]:
				xmin = 742.104
				xmax = 743.827
				text = "svoboda , na primər ,"
			intervals [60]:
				xmin = 743.827
				xmax = 746.461
				text = "je prav v tem času dobila svoj"
			intervals [61]:
				xmin = 746.461
				xmax = 748.043
				text = "pluralni pomen"
			intervals [62]:
				xmin = 748.043
				xmax = 752.906
				text = "ali , kot bi dejal nemški zgodovinar Rajnhart Kozelek ,"
			intervals [63]:
				xmin = 752.906
				xmax = 756.432
				text = "dobila je status občega pojma ."
			intervals [64]:
				xmin = 756.432
				xmax = 763.116
				text = "pojəm svobode od druge polovice osəmnajstega stoletja ni opisoval ali ni več opisoval , eem ,"
			intervals [65]:
				xmin = 763.116
				xmax = 765.769
				text = "samo statusa posameznika , eem ,"
			intervals [66]:
				xmin = 765.769
				xmax = 770.418
				text = "svobodnjaka oziroma tlačana , zapornika ali človeka na prostosti ,"
			intervals [67]:
				xmin = 770.418
				xmax = 774.892
				text = "temvəč je začel predstavljati bolj kompleksna stanja ."
			intervals [68]:
				xmin = 774.892
				xmax = 776.885
				text = "ali kot bi dejal Kozelək ,"
			intervals [69]:
				xmin = 776.885
				xmax = 786.026
				text = "goli opis nekega konkretnega razmerja je prešəl v abstraktno poimenovanje družbenega stanja ."
			intervals [70]:
				xmin = 786.026
				xmax = 788.875
				text = "podobno velja za novo"
			intervals [71]:
				xmin = 788.875
				xmax = 792.248
				text = "oživlje… oživljena pojma demokracija"
			intervals [72]:
				xmin = 792.248
				xmax = 793.778
				text = "in republika ,"
			intervals [73]:
				xmin = 793.778
				xmax = 798.03
				text = "ki sta razən v mestnih državi… državicah"
			intervals [74]:
				xmin = 798.03
				xmax = 800.805
				text = "po ape… Apeninskəm polotoku"
			intervals [75]:
