				text = "vsem po vrsti želim uspešən nastop in"
			intervals [131]:
				xmin = 941.592
				xmax = 942.591
				text = "veliko"
			intervals [132]:
				xmin = 942.591
				xmax = 944.694
				text = "vsebinske disku… ."
			intervals [133]:
				xmin = 944.694
				xmax = 947.83
				text = ""
			intervals [134]:
				xmin = 947.83
				xmax = 950.689
				text = "pozdravim še , eem , morebitne"
			intervals [135]:
				xmin = 950.689
				xmax = 954.677
				text = "kolegice in kolege s k… s tujine , ki slovenščine ,"
			intervals [136]:
				xmin = 954.677
				xmax = 959.342
				text = "eem , ne razumejo , in brez skrbi , ne bom se prevajal v celoti ."
			intervals [137]:
				xmin = 959.342
				xmax = 961.871
				text = "gre samo za pozdrav . torəj :"
			intervals [138]:
				xmin = 961.871
				xmax = 986.43
				text = ""
			intervals [139]:
				xmin = 986.43
				xmax = 988.166
				text = "Hvala lepa ."
			intervals [140]:
				xmin = 988.166
				xmax = 989.448
				text = ""
			intervals [141]:
				xmin = 989.448
				xmax = 1000.258
				text = "hvala lepa Otu Lutarju za ta pozdrav , tudi za nagovor , e , v angleščini našim gostom iz tujine , kateremu se səvəda pridružujəm ."
			intervals [142]:
				xmin = 1000.258
				xmax = 1007.135
				text = "kot səm že omenil , so , e , okoliščine nekako spremenile naš prvotni načrt ,"
			intervals [143]:
				xmin = 1007.135
				xmax = 1013.179
				text = "eee , rušile so se oziroma spreminjale provzoprov vse do pred kratkim , še ko smo pripravljali ,"
			intervals [144]:
				xmin = 1013.179
				xmax = 1015.533
				text = "e , vabilo , tako da"
			intervals [145]:
				xmin = 1015.533
				xmax = 1016.791
				text = "tudi še potem ."
			intervals [146]:
				xmin = 1016.791
				xmax = 1022.53
				text = "tako da moram za… žal opravičiti , ker so okoliščine tudi spremenile , da naslednjega govorca ,"
			intervals [147]:
				xmin = 1022.53
				xmax = 1032.552
				text = "eee , iz… predstavnika Mestne občine Ljubljana zaradi nepredvidenih okoliščin se ne more vklopi… , e , vključiti və naš pogovor in naše dogajanje ,"
			intervals [148]:
				xmin = 1032.552
				xmax = 1033.466
				text = "tako da"
			intervals [149]:
				xmin = 1033.466
				xmax = 1034.349
				text = "prosim ,"
			intervals [150]:
				xmin = 1034.349
				xmax = 1039.374
				text = "da kar sedaj prisluhnemo pozdravnim besedam , ki nam jih je posredoval"
			intervals [151]:
				xmin = 1039.374
				xmax = 1043.919
				text = "predsednik Republike Slovenije , častni pokrovitəlj konference , gospod"
			intervals [152]:
				xmin = 1043.919
				xmax = 1044.558
				text = "Borut"
			intervals [153]:
				xmin = 1044.558
				xmax = 1045.267
				text = "Pahor ."
			intervals [154]:
				xmin = 1045.267
				xmax = 1054.315
				text = ""
			intervals [155]:
				xmin = 1054.315
				xmax = 1056.953
				text = "spoštovani predsednik Slovenske matice ,"
			intervals [156]:
				xmin = 1056.953
				xmax = 1063.054
				text = "spoštovani direktor Znanstvenoraziskovalnega središča Slovenske akademije znanosti in umetnosti ,"
			intervals [157]:
				xmin = 1063.054
				xmax = 1066.754
				text = "spoštovani župan , udeleženci mednarodne konference"
			intervals [158]:
				xmin = 1066.754
				xmax = 1068.174
				text = "Kongres po Dunaju ,"
			intervals [159]:
				xmin = 1068.174
				xmax = 1069.689
				text = "dame in gospodje ."
			intervals [160]:
				xmin = 1069.689
				xmax = 1071.879
				text = "s kongresom Svete alianse"
			intervals [161]:
				xmin = 1071.879
				xmax = 1074.576
				text = "je bila Ljubljana pred dvesto leti"
			intervals [162]:
				xmin = 1074.576
				xmax = 1078.629
				text = "postavljena na evropski politični zemljevid ."
			intervals [163]:
				xmin = 1078.629
				xmax = 1080.284
				text = "pozdravljam pobudo ,"
			intervals [164]:
				xmin = 1080.284
				xmax = 1082.379
				text = "da se ob tej pomembni obletnici"
			intervals [165]:
				xmin = 1082.379
				xmax = 1084.55
				text = "pogovorimo o pomenu kongresa"
			intervals [166]:
				xmin = 1084.55
				xmax = 1087.17
				text = "za nadaljnji razvoj mednarodnih odnosov"
			intervals [167]:
				xmin = 1087.17
				xmax = 1089.334
				text = "in naše mesto v njem ."
