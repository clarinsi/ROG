				text = "eee , rušile so se oziroma spreminjale pravzaprav vse do pred kratkim , še ko smo pripravljali ,"
			intervals [144]:
				xmin = 1013.179
				xmax = 1015.533
				text = "e , vabilo , tako da"
			intervals [145]:
				xmin = 1015.533
				xmax = 1016.791
				text = "tudi še potem ."
			intervals [146]:
				xmin = 1016.791
				xmax = 1022.53
				text = "tako da moram za… žal opravičiti , ker so okoliščine tudi spremenile , da naslednjega govorca ,"
			intervals [147]:
				xmin = 1022.53
				xmax = 1032.552
				text = "eee , iz… predstavnika Mestne občine Ljubljana zaradi nepredvidenih okoliščin se ne more vklopi… , e , vključiti v naš pogovor in naše dogajanje ,"
			intervals [148]:
				xmin = 1032.552
				xmax = 1033.466
				text = "tako da"
			intervals [149]:
				xmin = 1033.466
				xmax = 1034.349
				text = "prosim ,"
			intervals [150]:
				xmin = 1034.349
				xmax = 1039.374
				text = "da kar sedaj prisluhnemo pozdravnim besedam , ki nam jih je posredoval"
			intervals [151]:
				xmin = 1039.374
				xmax = 1043.919
				text = "predsednik Republike Slovenije , častni pokrovitelj konference , gospod"
			intervals [152]:
				xmin = 1043.919
				xmax = 1044.558
				text = "Borut"
			intervals [153]:
				xmin = 1044.558
				xmax = 1045.267
				text = "Pahor ."
			intervals [154]:
				xmin = 1045.267
				xmax = 1054.315
				text = ""
			intervals [155]:
				xmin = 1054.315
				xmax = 1056.953
				text = "spoštovani predsednik Slovenske matice ,"
			intervals [156]:
				xmin = 1056.953
				xmax = 1063.054
				text = "spoštovani direktor Znanstvenoraziskovalnega središča Slovenske akademije znanosti in umetnosti ,"
			intervals [157]:
				xmin = 1063.054
				xmax = 1066.754
				text = "spoštovani župan , udeleženci mednarodne konference"
			intervals [158]:
				xmin = 1066.754
				xmax = 1068.174
				text = "Kongres po Dunaju ,"
			intervals [159]:
				xmin = 1068.174
				xmax = 1069.689
				text = "dame in gospodje ."
			intervals [160]:
				xmin = 1069.689
				xmax = 1071.879
				text = "s kongresom Svete alianse"
			intervals [161]:
				xmin = 1071.879
				xmax = 1074.576
				text = "je bila Ljubljana pred dvesto leti"
			intervals [162]:
				xmin = 1074.576
				xmax = 1078.629
				text = "postavljena na evropski politični zemljevid ."
			intervals [163]:
				xmin = 1078.629
				xmax = 1080.284
				text = "pozdravljam pobudo ,"
			intervals [164]:
				xmin = 1080.284
				xmax = 1082.379
				text = "da se ob tej pomembni obletnici"
			intervals [165]:
				xmin = 1082.379
				xmax = 1084.55
				text = "pogovorimo o pomenu kongresa"
			intervals [166]:
				xmin = 1084.55
				xmax = 1087.17
				text = "za nadaljnji razvoj mednarodnih odnosov"
			intervals [167]:
				xmin = 1087.17
				xmax = 1089.334
				text = "in naše mesto v njem ."
