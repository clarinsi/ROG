				xmax = 885.805
				text = "če bi to iz kakršnega koli razloga spregledali ,"
			intervals [106]:
				xmin = 885.805
				xmax = 887.919
				text = "bi tudi mi ostali na ravni"
			intervals [107]:
				xmin = 887.919
				xmax = 894.005
				text = "vsakokratne komodifikacije dogodkov , vezanih na okrogle obletnice ."
			intervals [108]:
				xmin = 894.005
				xmax = 896.857
				text = "brez refleksije temeljnih zgodovinskih pojmov"
			intervals [109]:
				xmin = 896.857
				xmax = 898.533
				text = "bi ostali na ravni"
			intervals [110]:
