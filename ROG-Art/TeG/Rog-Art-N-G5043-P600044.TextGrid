		intervals: size = 70
			intervals [1]:
				xmin = 2.346
				xmax = 4.598
				text = "pozdravljen , Drago ,"
			intervals [2]:
				xmin = 4.598
				xmax = 7.184
				text = "kofeta nama kuhala zdaj , ali ?"
			intervals [3]:
				xmin = 7.184
				xmax = 10.583
				text = "e , a veš , kaj sem študiral , da se malo"
			intervals [4]:
				xmin = 10.583
				xmax = 16.104
				text = "zmeniva , kako je bilo tavžent devetsto triinosemdesetega leta , ko smo šli na Pokljuko ."
			intervals [5]:
				xmin = 16.104
				xmax = 19.494
				text = ""
			intervals [6]:
				xmin = 19.494
				xmax = 23.416
				text = "triinosemdeset , ker takrat sem bil zadnjikrat na Po… e Triglavu ."
			intervals [7]:
				xmin = 23.416
				xmax = 26.917
				text = ""
			intervals [8]:
				xmin = 26.917
				xmax = 30.032
				text = "iz biroja sem bil samo jaz pa ti ."
			intervals [9]:
				xmin = 30.032
				xmax = 31.443
				text = ""
			intervals [10]:
				xmin = 31.443
				xmax = 33.147
				text = "ne ."
			intervals [11]:
				xmin = 33.147
				xmax = 38.296
				text = ""
			intervals [12]:
				xmin = 38.296
				xmax = 39.479
				text = "ne ."
			intervals [13]:
				xmin = 39.479
				xmax = 43.167
				text = "jaz se ga ne spomnim . spomnim se Ikovica ,"
			intervals [14]:
				xmin = 43.167
				xmax = 44.66
				text = "Germana"
			intervals [15]:
				xmin = 44.66
				xmax = 48.106
				text = "pa onega iz e Slovenj Gradca ,"
			intervals [16]:
				xmin = 48.106
				xmax = 50.254
				text = "umetnika ."
			intervals [17]:
				xmin = 50.254
				xmax = 51.417
				text = ""
			intervals [18]:
				xmin = 51.417
				xmax = 53.259
				text = "[ime] [priimek]"
			intervals [19]:
				xmin = 53.259
				xmax = 54.718
				text = "pa tebe pa jaz ."
			intervals [20]:
				xmin = 54.718
				xmax = 58.977
				text = "pa te je bil še , meni se zdi , ne , pa ni bil kos ."
			intervals [21]:
				xmin = 58.977
				xmax = 88.686
				text = ""
			intervals [22]:
				xmin = 88.686
				xmax = 90.844
				text = "eee ,"
			intervals [23]:
				xmin = 90.844
				xmax = 91.735
				text = "samo ,"
			intervals [24]:
				xmin = 91.735
				xmax = 95.38
				text = "a ni bil pobudnik tega pa [ime] [priimek] ?"
			intervals [25]:
				xmin = 95.38
				xmax = 98.748
				text = ""
			intervals [26]:
				xmin = 98.748
				xmax = 101.569
				text = "začetek ."
			intervals [27]:
				xmin = 101.569
				xmax = 102.642
				text = "ne vem ."
			intervals [28]:
				xmin = 102.642
				xmax = 135.253
				text = ""
			intervals [29]:
				xmin = 135.253
				xmax = 137.316
				text = "ja , ker jaz se spomnim ,"
			intervals [30]:
				xmin = 137.316
				xmax = 139.087
				text = "da sem pa šel"
			intervals [31]:
				xmin = 139.087
				xmax = 141.599
				text = "na enem izmed teh pohodov na"
			intervals [32]:
				xmin = 141.599
				xmax = 145.024
				text = "Kamniško sedlo iz Kamniške Bistrice gor ."
			intervals [33]:
				xmin = 145.024
				xmax = 147.445
				text = "najbolj se spomnim tiste"
			intervals [34]:
				xmin = 147.445
				xmax = 150.145
				text = "steze gorta do sedla ."
			intervals [35]:
				xmin = 150.145
				xmax = 153.865
				text = "te sem bil popolnoma brez kondicije ."
			intervals [36]:
				xmin = 153.865
				xmax = 155.941
				text = "ampak sem prišel na vrh ."
			intervals [37]:
				xmin = 155.941
				xmax = 157.495
				text = ""
			intervals [38]:
				xmin = 157.495
				xmax = 159.606
				text = "ja , če ne bi pa spodaj ostal ."
			intervals [39]:
				xmin = 159.606
				xmax = 176.396
				text = ""
			intervals [40]:
				xmin = 176.396
				xmax = 178.829
				text = "a ni smo šli pol na ono stran dol ?"
			intervals [41]:
				xmin = 178.829
				xmax = 179.88
				text = ""
			intervals [42]:
				xmin = 179.88
				xmax = 181.166
				text = "dolta v …"
			intervals [43]:
				xmin = 181.166
				xmax = 181.984
				text = ""
			intervals [44]:
				xmin = 181.984
				xmax = 183.763
				text = "Pa dolta v Logarsko ."
			intervals [45]:
				xmin = 183.763
				xmax = 184.775
				text = "ja , ja ."
			intervals [46]:
				xmin = 184.775
				xmax = 194.431
				text = ""
			intervals [47]:
				xmin = 194.431
				xmax = 198.552
				text = "ja , no , in pol smo se zbrali zjutraj , koliko je bila ura , pet ?"
			intervals [48]:
				xmin = 198.552
				xmax = 199.531
				text = "ali"
			intervals [49]:
				xmin = 199.531
				xmax = 200.984
				text = "okrog petih ,"
			intervals [50]:
				xmin = 200.984
				xmax = 203.508
				text = "na avtobusni postaji"
			intervals [51]:
				xmin = 203.508
				xmax = 206.004
				text = "nas je bilo za en avtobus ."
			intervals [52]:
				xmin = 206.004
				xmax = 240.12
				text = ""
			intervals [53]:
				xmin = 240.12
				xmax = 248.013
				text = "jaz se spomnim , ko sem bil prvič na Triglavu , to je bilo petnajstega avgusta tisoč devetsto štiriinšestdeset ,"
			intervals [54]:
				xmin = 248.013
				xmax = 252.019
				text = "sem spal na Kredarici v stari koči ."
			intervals [55]:
				xmin = 252.019
				xmax = 255.939
				text = "ko sem šel na drugi pohod , sem spal na Staničevi koči ."
			intervals [56]:
				xmin = 255.939
				xmax = 260.662
				text = "ko sem šel pa na tretji pohod , sem spal pa na e Planiki ."
			intervals [57]:
				xmin = 260.662
				xmax = 263.095
				text = "in od tam smo tudi šli na vrh ."
			intervals [58]:
				xmin = 263.095
				xmax = 264.454
				text = "ampak to drugi dan ,"
			intervals [59]:
				xmin = 264.454
				xmax = 266.012
				text = "ne prvi dan ."
			intervals [60]:
				xmin = 266.012
				xmax = 267.06
				text = ""
			intervals [61]:
				xmin = 267.06
				xmax = 267.93
				text = "zjutraj ."
			intervals [62]:
				xmin = 267.93
				xmax = 286.444
				text = ""
			intervals [63]:
				xmin = 286.444
				xmax = 289.746
				text = "jaz se bolj spomnim , da smo šli v dolino Krme ."
			intervals [64]:
				xmin = 289.746
				xmax = 293.785
				text = "v Kovinarsko kočo iz , a to je jeseniška koča gor ali čigava ?"
			intervals [65]:
				xmin = 293.785
				xmax = 295.431
				text = "kovinarska koča ."
			intervals [66]:
				xmin = 295.431
				xmax = 304.653
				text = ""
			intervals [67]:
				xmin = 304.653
				xmax = 308.466
				text = "no , te se spomnim , da smo prišli tam dol ,"
			intervals [68]:
				xmin = 308.466
				xmax = 309.713
				text = "ampak vem ,"
			intervals [69]:
				xmin = 309.713
				xmax = 311.743
