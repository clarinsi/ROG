				xmax = 176.396
				text = ""
			intervals [40]:
				xmin = 176.396
				xmax = 178.829
				text = "a ni smo šli pol na uno stran dov ?"
			intervals [41]:
				xmin = 178.829
				xmax = 179.88
				text = ""
			intervals [42]:
				xmin = 179.88
				xmax = 181.166
				text = "douta və …"
			intervals [43]:
				xmin = 181.166
				xmax = 181.984
				text = ""
			intervals [44]:
				xmin = 181.984
				xmax = 183.763
				text = "Pa dovta v Logarsko ."
			intervals [45]:
				xmin = 183.763
				xmax = 184.775
				text = "ja , ja ."
			intervals [46]:
				xmin = 184.775
				xmax = 194.431
				text = ""
			intervals [47]:
				xmin = 194.431
				xmax = 198.552
				text = "ja , no , in pol smo se zbrali zutra , kejk je bla ura , pet ?"
			intervals [48]:
				xmin = 198.552
				xmax = 199.531
				text = "al"
			intervals [49]:
				xmin = 199.531
				xmax = 200.984
				text = "okrog petih ,"
			intervals [50]:
				xmin = 200.984
				xmax = 203.508
				text = "na avtobusni postaji"
			intervals [51]:
				xmin = 203.508
				xmax = 206.004
				text = "nas je bov za en avtobus ."
			intervals [52]:
				xmin = 206.004
				xmax = 240.12
				text = ""
			intervals [53]:
				xmin = 240.12
				xmax = 248.013
				text = "jes se spomnəm , ko səm bil prvič na Triglavu , to je blo pətnajstəga avgusta tisoč devetsto štərinšestdəsət ,"
			intervals [54]:
				xmin = 248.013
				xmax = 252.019
				text = "səm spal na Kredarici v stari koči ."
			intervals [55]:
				xmin = 252.019
				xmax = 255.939
				text = "ko səm šov na drugi pohod , səm spal na Staničəvi koči ."
			intervals [56]:
				xmin = 255.939
				xmax = 260.662
				text = "ko səm šəl pa na tretji pohod , səm spal pa na e Planiki ."
			intervals [57]:
				xmin = 260.662
				xmax = 263.095
				text = "in od tam smo tudi šli na vrh ."
			intervals [58]:
				xmin = 263.095
				xmax = 264.454
				text = "ampak to drugi dan ,"
			intervals [59]:
				xmin = 264.454
				xmax = 266.012
				text = "ne prvi dan ."
			intervals [60]:
				xmin = 266.012
				xmax = 267.06
				text = ""
			intervals [61]:
				xmin = 267.06
				xmax = 267.93
				text = "zutra ."
			intervals [62]:
				xmin = 267.93
				xmax = 286.444
				text = ""
			intervals [63]:
				xmin = 286.444
				xmax = 289.746
				text = "jəz se bol spomnəm , da smo šli v dolino Krme ."
			intervals [64]:
				xmin = 289.746
				xmax = 293.785
				text = "v Kovinarsko kočo iz , a to je jeseniška koča gor al čigava ?"
			intervals [65]:
				xmin = 293.785
				xmax = 295.431
				text = "kovinarska koča ."
			intervals [66]:
				xmin = 295.431
				xmax = 304.653
				text = ""
			intervals [67]:
				xmin = 304.653
				xmax = 308.466
				text = "no , tə sə spomnim , da smo prəšli tam dov ,"
			intervals [68]:
				xmin = 308.466
				xmax = 309.713
				text = "ampak vem ,"
			intervals [69]:
				xmin = 309.713
				xmax = 311.743
				text = "da so Gorenjci , ne ,"
			intervals [70]:
				xmin = 311.743
				xmax = 314.631
				text = "da niso mel niti enga mrzlega piva ."
