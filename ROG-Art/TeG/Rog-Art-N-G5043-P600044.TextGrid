	item [5]:
		class = "IntervalTier"
		name = "conversational-trs"
		xmin = 2.346
		xmax = 314.631
		intervals: size = 70
			intervals [1]:
				xmin = 2.346
				xmax = 4.598
				text = "pozdravlən , Drago ,"
			intervals [2]:
				xmin = 4.598
				xmax = 7.184
				text = "kufeja nama kuhava zaj , al ?"
			intervals [3]:
				xmin = 7.184
				xmax = 10.583
				text = "e , a veš , kaj səm študiru , da se mal"
			intervals [4]:
				xmin = 10.583
				xmax = 16.104
				text = "zmenima , kək je blo taužənt devetsto triinosəmdəsətəga leta , ko smo šli na Pokluko ."
			intervals [5]:
				xmin = 16.104
				xmax = 19.494
				text = ""
			intervals [6]:
				xmin = 19.494
				xmax = 23.416
				text = "triinosəmdəst , kə takrət səm bil zadnokrat na Po… e Triglavu ."
			intervals [7]:
				xmin = 23.416
				xmax = 26.917
				text = ""
			intervals [8]:
				xmin = 26.917
				xmax = 30.032
				text = "iz buroja səm bil samo jəz pa ti ."
			intervals [9]:
				xmin = 30.032
				xmax = 31.443
				text = ""
			intervals [10]:
				xmin = 31.443
				xmax = 33.147
				text = "ne ."
			intervals [11]:
				xmin = 33.147
				xmax = 38.296
				text = ""
			intervals [12]:
				xmin = 38.296
				xmax = 39.479
				text = "ne ."
			intervals [13]:
				xmin = 39.479
				xmax = 43.167
				text = "jəz se ga ne spomnəm . spomnəm se Ikovica ,"
			intervals [14]:
				xmin = 43.167
				xmax = 44.66
				text = "Germana"
			intervals [15]:
				xmin = 44.66
				xmax = 48.106
				text = "pa uniga iz e Slovenj Gradca ,"
			intervals [16]:
				xmin = 48.106
				xmax = 50.254
				text = "umetnika ."
			intervals [17]:
				xmin = 50.254
				xmax = 51.417
				text = ""
			intervals [18]:
				xmin = 51.417
				xmax = 53.259
				text = "[ime] [priimek]"
			intervals [19]:
				xmin = 53.259
				xmax = 54.718
				text = "pa tebe pa jəz ."
			intervals [20]:
				xmin = 54.718
				xmax = 58.977
				text = "pa tej je bil še , mən se zdi , ne , pa ni bil kos ."
			intervals [21]:
				xmin = 58.977
				xmax = 88.686
				text = ""
			intervals [22]:
				xmin = 88.686
				xmax = 90.844
				text = "eee ,"
			intervals [23]:
				xmin = 90.844
				xmax = 91.735
				text = "samo ,"
			intervals [24]:
				xmin = 91.735
				xmax = 95.38
				text = "a ni bil pobudnik tega pa [ime] [priimek] ?"
			intervals [25]:
				xmin = 95.38
				xmax = 98.748
				text = ""
			intervals [26]:
				xmin = 98.748
				xmax = 101.569
				text = "začetək ."
			intervals [27]:
				xmin = 101.569
				xmax = 102.642
				text = "ne vem ."
			intervals [28]:
				xmin = 102.642
				xmax = 135.253
				text = ""
			intervals [29]:
				xmin = 135.253
				xmax = 137.316
				text = "ja , ker jəz se spomnim ,"
			intervals [30]:
				xmin = 137.316
				xmax = 139.087
				text = "da səm pa šov"
			intervals [31]:
				xmin = 139.087
				xmax = 141.599
				text = "na enem izməd teh pohodov na"
			intervals [32]:
				xmin = 141.599
				xmax = 145.024
				text = "Kamniško sedlo iz Kamniške Bistərce gər ."
			intervals [33]:
				xmin = 145.024
				xmax = 147.445
				text = "najbolj se spomnəm təste"
			intervals [34]:
				xmin = 147.445
				xmax = 150.145
				text = "stezde gərta do sedla ."
			intervals [35]:
				xmin = 150.145
				xmax = 153.865
				text = "te səm bil popolnoma brez kondicije ."
			intervals [36]:
				xmin = 153.865
				xmax = 155.941
				text = "ampak səm pəršu na vrh ."
			intervals [37]:
				xmin = 155.941
				xmax = 157.495
				text = ""
			intervals [38]:
				xmin = 157.495
				xmax = 159.606
				text = "ja , če ne bi pa spoda ostu ."
			intervals [39]:
