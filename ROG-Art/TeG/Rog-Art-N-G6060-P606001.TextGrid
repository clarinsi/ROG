		intervals: size = 101
			intervals [1]:
				xmin = 4.174
				xmax = 10.379
				text = "prvič səm se srečala z lindi hopom oziris… oziroma sving plesom"
			intervals [2]:
				xmin = 10.379
				xmax = 12.478
				text = "leta dva tisoč osem ."
			intervals [3]:
				xmin = 12.478
				xmax = 16.308
				text = "tako da takrat sem začela plesat v Ljubljani ,"
			intervals [4]:
				xmin = 16.308
				xmax = 18.362
				text = "bila sem še študentka"
			intervals [5]:
				xmin = 18.362
				xmax = 24.112
				text = "in navdušila me je moja sodelavka oziroma prijateljica , da vsaj poskusim ."
			intervals [6]:
				xmin = 24.112
				xmax = 31.166
				text = "všeč mi je bla ta glasba , všeč so mi bili ljudje , sproščeni , nasmejani"
			intervals [7]:
				xmin = 31.166
				xmax = 38.01
				text = "in predvsem to , da ne potrebuješ stalnega partnerja za ples , ampak vsako drugo pesem"
			intervals [8]:
				xmin = 38.01
				xmax = 40.278
				text = "se partnerje zamenja"
			intervals [9]:
				xmin = 40.278
				xmax = 40.916
				text = "in"
			intervals [10]:
				xmin = 40.916
				xmax = 43.952
				text = "gremo jovo na novo ."
			intervals [11]:
				xmin = 43.952
				xmax = 53.184
				text = ""
			intervals [12]:
				xmin = 53.184
				xmax = 56.131
				text = "ples sem poznala iz filmov ,"
			intervals [13]:
				xmin = 56.131
				xmax = 58.711
				text = "predvsem Briljatina ali"
			intervals [14]:
				xmin = 58.711
				xmax = 61.479
				text = "podobno pač ples izhaja iz dobe ,"
			intervals [15]:
				xmin = 61.479
				xmax = 66.814
				text = "e , džeza , solo džeza , dvajsəta , tridəsəta leta prejšnje$ga stoletja"
			intervals [16]:
				xmin = 66.814
				xmax = 70.944
				text = "in predvsem iz področja , eem ,"
			intervals [17]:
				xmin = 70.944
				xmax = 75.935
				text = "Nju Orlinsa oziroma ali oko… , notrej… v Nju Jorku"
			intervals [18]:
				xmin = 75.935
				xmax = 77.832
				text = "so velik preplesali ,"
			intervals [19]:
				xmin = 77.832
				xmax = 81.091
				text = "predvsem temnopolti oziroma črnci ."
			intervals [20]:
				xmin = 81.091
				xmax = 88.435
				text = "eem , in so to nekək imeli kot zabavo po trdih delovnih dneh v času sužənjstva"
			intervals [21]:
				xmin = 88.435
				xmax = 91.158
				text = "in pač diskriminacije ,"
			intervals [22]:
				xmin = 91.158
				xmax = 94.038
				text = "kjer so nekək našli svoj ,"
			intervals [23]:
				xmin = 94.038
				xmax = 97.645
				text = "svoj mir , svojo živahnost , da so se lahko sprostili ."
			intervals [24]:
				xmin = 97.645
				xmax = 105.346
				text = ""
			intervals [25]:
				xmin = 105.346
				xmax = 109.654
				text = "v Sloveniji mamo velik plesnih klubov , lahko se pleše"
			intervals [26]:
				xmin = 109.654
				xmax = 113.784
				text = "v Ljubljani , v Mariboru , v Kranju , v Kopru"
			intervals [27]:
				xmin = 113.784
				xmax = 118.15
				text = "tudi nekaj časa so , smo , e , poskusəl , eee ,"
			intervals [28]:
				xmin = 118.15
				xmax = 122.034
				text = "poskušal plesat və moji rodni Idriji ."
			intervals [29]:
				xmin = 122.034
				xmax = 128.641
				text = "e , sedaj pa imamo tud kər nekaj festivalov , tudi v Celju in je zelo razgibana scena ."
			intervals [30]:
				xmin = 128.641
				xmax = 133.931
				text = "e , veliko ljudi pleše , sicer pa še vedno prevladujemo"
			intervals [31]:
