				xmax = 151.137
				text = "festivali so večinoma zgrajeni tako , da imamo čez dan delavnice z različnimi mednarodnimi učitənli ."
			intervals [35]:
				xmin = 151.137
				xmax = 158.258
				text = "potem se greš pač , e , stuširat potemo , ko nekək cel dan vadiš in švicaš ."
			intervals [36]:
				xmin = 158.258
				xmax = 163.74
