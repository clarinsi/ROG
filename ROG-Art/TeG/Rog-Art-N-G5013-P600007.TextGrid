	item [5]:
		class = "IntervalTier"
		name = "conversational-trs"
		xmin = 0.0
		xmax = 335.914
		intervals: size = 91
			intervals [1]:
				xmin = 0.0
				xmax = 2.963
				text = "kere igərce najrajši špilaš ?"
			intervals [2]:
				xmin = 2.963
				xmax = 24.932
				text = ""
			intervals [3]:
				xmin = 24.932
				xmax = 27.762
				text = "jas sən fčasih igral Roket Lig"
			intervals [4]:
				xmin = 27.762
				xmax = 31.69
				text = "pa še to pač tak malo , drugač pa nisən jas lih za igərce ."
			intervals [5]:
				xmin = 31.69
				xmax = 34.622
				text = "rajši delam muziko pa"
			intervals [6]:
				xmin = 34.622
				xmax = 35.87
				text = "ne vem ,"
			intervals [7]:
				xmin = 35.87
				xmax = 37.349
				text = "kej drugega rajši ."
			intervals [8]:
				xmin = 37.349
				xmax = 39.709
				text = ""
			intervals [9]:
				xmin = 39.709
				xmax = 44.255
				text = "zaj delam muziko dve leti , drugač pa sən harmoniko špilo deset let ."
			intervals [10]:
				xmin = 44.255
				xmax = 47.959
				text = "eee pa sən bil tuji po tekmovanji pa neka dosego ."
			intervals [11]:
				xmin = 47.959
				xmax = 50.239
				text = "pol sən se začel tuji učit klavir ."
			intervals [12]:
				xmin = 50.239
				xmax = 54.106
				text = "eem to mi ni blo tak zanimivo glih , ker eee"
			intervals [13]:
				xmin = 54.106
				xmax = 56.548
				text = "sən se po notah pa fse pa"
			intervals [14]:
				xmin = 56.548
				xmax = 63.5
				text = "rajši bi te se kea naučo , da bi zašpilat znal , zaj pa znam samo lestvice pa to , zašpilat pa nič ."
			intervals [15]:
				xmin = 63.5
				xmax = 68.278
				text = "po pa sən se še zaj f karanteni naučo kitaro , tolko malo ."
			intervals [16]:
				xmin = 68.278
				xmax = 70.357
				text = "za finte ."
			intervals [17]:
				xmin = 70.357
				xmax = 72.823
				text = ""
			intervals [18]:
				xmin = 72.823
				xmax = 74.005
				text = "recimo , ja ."
			intervals [19]:
				xmin = 74.005
				xmax = 75.677
				text = ""
			intervals [20]:
				xmin = 75.677
				xmax = 76.849
				text = "ja , zaj ."
			intervals [21]:
				xmin = 76.849
				xmax = 78.105
				text = ""
			intervals [22]:
				xmin = 78.105
				xmax = 79.995
				text = "glasbeno šolo sən narejo pet let ,"
			intervals [23]:
				xmin = 79.995
				xmax = 83.416
				text = "sam zadnega letnika nisən , samo teorijo sən delo ,"
			intervals [24]:
				xmin = 83.416
				xmax = 89.059
				text = "ker eem takrat še ni blo za frajtonarco sploh uradno , da lahko položiš izpite ."
			intervals [25]:
				xmin = 89.059
				xmax = 95.458
				text = "po pa se mi ni splačalo pa hodo sən tam pa so bli fsi tri , štiri leta mlajši od mene pa"
			intervals [26]:
				xmin = 95.458
				xmax = 99.411
				text = "nis se mogo z nikom družit pa eee ni mi blo v užitek ta hodit ."
			intervals [27]:
				xmin = 99.411
				xmax = 115.796
				text = ""
			intervals [28]:
				xmin = 115.796
				xmax = 121.481
				text = "drugač dosti ljudi neuradno uči , na črno , pa ne rabijo ,"
			intervals [29]:
				xmin = 121.481
				xmax = 126.648
				text = "ampak ja , mogo bi pa v zvezo bi te mogli sprejet harmonikarjev Slovenije ."
			intervals [30]:
				xmin = 126.648
				xmax = 130.673
				text = "pa potem espe bi mogo odpret pa fse ,"
			intervals [31]:
				xmin = 130.673
				xmax = 132.347
				text = "to pa se mi zaj ne splača ."
			intervals [32]:
				xmin = 132.347
				xmax = 137.419
				text = ""
			intervals [33]:
				xmin = 137.419
				xmax = 140.469
				text = "kər , ja , kər tisti , k so u zvezi , so že"
			intervals [34]:
				xmin = 140.469
				xmax = 145.304
				text = "dosti let na sceni , petnajst , dvajst al pa mao ansamble pa"
			intervals [35]:
				xmin = 145.304
				xmax = 147.29
				text = "dosti učencev pa fse"
			intervals [36]:
				xmin = 147.29
				xmax = 149.043
				text = ""
			intervals [37]:
				xmin = 149.043
				xmax = 153.091
				text = "Ja , toti so fsi bli svetovni al pa evropski al pa neka ziher ."
			intervals [38]:
				xmin = 153.091
				xmax = 156.25
				text = ""
			intervals [39]:
				xmin = 156.25
				xmax = 163.469
				text = "takrat ko sən še bil šestnajst , petnajst star , so mi pisali , če bi špilo və ansambli pa to , samo sən še"
			intervals [40]:
				xmin = 163.469
				xmax = 166.936
				text = "na tekmovanja hoto it pa da bi kaj dosego ,"
			intervals [41]:
				xmin = 166.936
				xmax = 170.043
				text = "po pa sən se , sən bil že kər dober"
			intervals [42]:
				xmin = 170.043
				xmax = 173.874
				text = "pa mi je tam komisija skos pravila spreminjala pa neka"
			intervals [43]:
				xmin = 173.874
				xmax = 175.237
				text = "pa ni se mi dalo ,"
			intervals [44]:
				xmin = 175.237
				xmax = 177.465
				text = "ker je fse to"
			intervals [45]:
				xmin = 177.465
				xmax = 180.111
				text = "glih tako"
			intervals [46]:
				xmin = 180.111
				xmax = 182.797
				text = "podkupleno fse pa nisən pol več hodo ."
			intervals [47]:
				xmin = 182.797
				xmax = 184.7
				text = ""
			intervals [48]:
				xmin = 184.7
				xmax = 187.851
				text = "ja . pa kolko jih pərpela ."
			intervals [49]:
				xmin = 187.851
				xmax = 189.34
				text = "pa še drugi ."
			intervals [50]:
				xmin = 189.34
				xmax = 192.804
				text = ""
			intervals [51]:
				xmin = 192.804
				xmax = 194.413
				text = "eee ."
			intervals [52]:
				xmin = 194.413
				xmax = 199.688
				text = "po Sloveniji pa və Italiji je tuji blo tekmovanje pa tudi və Avstriji"
			intervals [53]:
				xmin = 199.688
				xmax = 201.644
				text = "je blo svetovno"
			intervals [54]:
				xmin = 201.644
				xmax = 204.233
				text = "eee drugač pa sən"
			intervals [55]:
				xmin = 204.233
				xmax = 206.332
				text = "Štajerskim frajtonarjami igral"
			intervals [56]:
				xmin = 206.332
				xmax = 208.503
				text = "tuji və Nemčiji pa"
			intervals [57]:
				xmin = 208.503
				xmax = 210.522
				text = "tak tisto je blo tuji vreji ."
			intervals [58]:
				xmin = 210.522
				xmax = 212.585
				text = "pa po Obali pa …"
			intervals [59]:
				xmin = 212.585
				xmax = 219.704
				text = ""
			intervals [60]:
				xmin = 219.704
				xmax = 222.288
				text = "Ponavadi , če je kako"
			intervals [61]:
				xmin = 222.288
				xmax = 226.83
				text = "pred… predtekmovanje , da morš se kvalificirat sploh"
			intervals [62]:
				xmin = 226.83
				xmax = 229.584
				text = "zə eno muziko al pa dvema , pol pa"
			intervals [63]:
				xmin = 229.584
				xmax = 231.702
				text = "si še ene dve , tri pustiš"
			intervals [64]:
				xmin = 231.702
				xmax = 235.259
				text = "pa še kaki finale , če je na konci , da se odloči , te pa …"
			intervals [65]:
				xmin = 235.259
				xmax = 242.127
				text = ""
			intervals [66]:
				xmin = 242.127
				xmax = 243.39
				text = "Ja ."
			intervals [67]:
				xmin = 243.39
				xmax = 245.889
				text = ""
			intervals [68]:
				xmin = 245.889
				xmax = 253.241
				text = "jəs sən se še to sam neka po notah učil pa mi je šlo počasi , ker je na harmoniki , pač ni to tak ko na klavire ."
			intervals [69]:
				xmin = 253.241
				xmax = 254.828
				text = ""
			intervals [70]:
				xmin = 254.828
				xmax = 257.064
				text = "ja , sən mel , samo pol sən ,"
			intervals [71]:
				xmin = 257.064
				xmax = 262.273
				text = "on , učitəl je bil iz Avstrije pa nisən mogo hodit tolkokrat tja pa še drago je blo pa fse ."
			intervals [72]:
				xmin = 262.273
				xmax = 265.463
				text = "pol pa sən se sam in sən rabo"
			intervals [73]:
				xmin = 265.463
				xmax = 267.378
				text = "kake pol leta ,"
			intervals [74]:
				xmin = 267.378
				xmax = 270.82
				text = "mislim , ne vem , čez zimo sən se učil , po pa sən še vado toto muziko ."
			intervals [75]:
				xmin = 270.82
				xmax = 273.073
				text = "tak k mi je že šlo na živce pa fse ."
			intervals [76]:
				xmin = 273.073
