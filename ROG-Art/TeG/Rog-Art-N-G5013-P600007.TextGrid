	item [2]:
		class = "IntervalTier"
		name = "standardized-trs"
		xmin = 0.0
		xmax = 335.914
		intervals: size = 91
			intervals [1]:
				xmin = 0.0
				xmax = 2.963
				text = "katere igrice najrajši špilaš ?"
			intervals [2]:
				xmin = 2.963
				xmax = 24.932
				text = ""
			intervals [3]:
				xmin = 24.932
				xmax = 27.762
				text = "jaz sem včasih igral Rocket League"
			intervals [4]:
				xmin = 27.762
				xmax = 31.69
				text = "pa še to pač tako malo , drugače pa nisem jaz glih za igrice ."
			intervals [5]:
				xmin = 31.69
				xmax = 34.622
				text = "rajši delam muziko pa"
			intervals [6]:
				xmin = 34.622
				xmax = 35.87
				text = "ne vem ,"
			intervals [7]:
				xmin = 35.87
				xmax = 37.349
				text = "kaj drugega rajši ."
			intervals [8]:
				xmin = 37.349
				xmax = 39.709
				text = ""
			intervals [9]:
				xmin = 39.709
				xmax = 44.255
				text = "zdaj delam muziko dve leti , drugače pa sem harmoniko špilal deset let ."
			intervals [10]:
				xmin = 44.255
				xmax = 47.959
				text = "eee pa sem bil tudi po tekmovanjih pa nekaj dosegel ."
			intervals [11]:
				xmin = 47.959
				xmax = 50.239
				text = "pol sem se začel tudi učiti klavir ."
			intervals [12]:
				xmin = 50.239
				xmax = 54.106
				text = "eem to mi ni bilo tako zanimivo glih , ker eee"
			intervals [13]:
				xmin = 54.106
				xmax = 56.548
				text = "sem se po notah pa vse pa"
			intervals [14]:
				xmin = 56.548
				xmax = 63.5
				text = "rajši bi te se kaj naučil , da bi zašpilati znal , zdaj pa znam samo lestvice pa to , zašpilati pa nič ."
			intervals [15]:
				xmin = 63.5
				xmax = 68.278
				text = "po pa sem se še zdaj v karanteni naučil kitaro , toliko malo ."
			intervals [16]:
				xmin = 68.278
				xmax = 70.357
				text = "za finte ."
			intervals [17]:
				xmin = 70.357
				xmax = 72.823
				text = ""
			intervals [18]:
				xmin = 72.823
				xmax = 74.005
				text = "recimo , ja ."
			intervals [19]:
				xmin = 74.005
				xmax = 75.677
				text = ""
			intervals [20]:
				xmin = 75.677
				xmax = 76.849
				text = "ja , zdaj ."
			intervals [21]:
				xmin = 76.849
				xmax = 78.105
				text = ""
			intervals [22]:
				xmin = 78.105
				xmax = 79.995
				text = "glasbeno šolo sem naredil pet let ,"
			intervals [23]:
				xmin = 79.995
				xmax = 83.416
				text = "samo zadnjega letnika nisem , samo teorijo sem delal ,"
			intervals [24]:
				xmin = 83.416
				xmax = 89.059
				text = "ker eem takrat še ni bilo za frajtonarico sploh uradno , da lahko položiš izpite ."
			intervals [25]:
				xmin = 89.059
				xmax = 95.458
				text = "po pa se mi ni splačalo pa hodil sem tam pa so bili vsi tri , štiri leta mlajši od mene pa"
			intervals [26]:
				xmin = 95.458
				xmax = 99.411
				text = "nisi se mogel z nikomer družiti pa eee ni mi bilo v užitek tja hoditi ."
			intervals [27]:
				xmin = 99.411
				xmax = 115.796
				text = ""
			intervals [28]:
				xmin = 115.796
				xmax = 121.481
				text = "drugače dosti ljudi neuradno uči , na črno , pa ne rabijo ,"
			intervals [29]:
				xmin = 121.481
				xmax = 126.648
				text = "ampak ja , moral bi pa v zvezo bi te morali sprejeti harmonikarjev Slovenije ."
			intervals [30]:
				xmin = 126.648
				xmax = 130.673
				text = "pa potem espe bi moral odpreti pa vse ,"
			intervals [31]:
				xmin = 130.673
				xmax = 132.347
				text = "to pa se mi zdaj ne splača ."
			intervals [32]:
				xmin = 132.347
				xmax = 137.419
				text = ""
			intervals [33]:
				xmin = 137.419
				xmax = 140.469
				text = "kar , ja , ker tisti , ki so v zvezi , so že"
			intervals [34]:
				xmin = 140.469
				xmax = 145.304
				text = "dosti let na sceni , petnajst , dvajset ali pa imajo ansamble pa"
			intervals [35]:
				xmin = 145.304
				xmax = 147.29
				text = "dosti učencev pa vse"
			intervals [36]:
				xmin = 147.29
				xmax = 149.043
				text = ""
			intervals [37]:
				xmin = 149.043
				xmax = 153.091
				text = "Ja , toti so vsi bili svetovni ali pa evropski ali pa nekaj ziher ."
			intervals [38]:
				xmin = 153.091
				xmax = 156.25
				text = ""
			intervals [39]:
				xmin = 156.25
				xmax = 163.469
				text = "takrat ko sem še bil šestnajst , petnajst star , so mi pisali , če bi špilal v ansamblu pa to , samo sem še"
			intervals [40]:
				xmin = 163.469
				xmax = 166.936
				text = "na tekmovanja hotel iti pa da bi kaj dosegel ,"
			intervals [41]:
				xmin = 166.936
				xmax = 170.043
				text = "po pa sem se , sem bil že kar dober"
			intervals [42]:
				xmin = 170.043
				xmax = 173.874
				text = "pa mi je tam komisija skozi pravila spreminjala pa nekaj"
			intervals [43]:
				xmin = 173.874
				xmax = 175.237
				text = "pa ni se mi dalo ,"
			intervals [44]:
