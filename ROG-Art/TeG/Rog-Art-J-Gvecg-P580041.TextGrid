	item [2]:
		class = "IntervalTier"
		name = "standardized-trs"
		xmin = 0.0
		xmax = 346.651
		intervals: size = 94
			intervals [1]:
				xmin = 0.0
				xmax = 8.414
				text = "Slovenci imamo duhovnika, ki se je z izvirnim pristopom k bogoslužju in s pozitivno naravnanostjo prikupil ljudem vseh generacij."
			intervals [2]:
				xmin = 8.414
				xmax = 13.192
				text = "Danes, na velikonočno nedeljo, je moj gost v studiu Štajerskega vala."
			intervals [3]:
				xmin = 13.192
				xmax = 16.33
				text = "Martin Golob, iskreno dobrodošli na Štajerskem."
			intervals [4]:
				xmin = 16.33
				xmax = 22.165
				text = "Hvala za povabilo in z veseljem sem med vami, veselimi ljudmi, na Štajerskem."
			intervals [5]:
				xmin = 22.165
				xmax = 26.04
				text = "Danes je največji krščanski praznik,"
			intervals [6]:
				xmin = 26.04
				xmax = 29.371
				text = "kako se ga spominjate, ko še niste bili v vlogi duhovnika?"
			intervals [7]:
				xmin = 29.371
				xmax = 37.201
				text = "#U, zelo lepo. Na veliko noč smo zelo kmalu doma vstali, da smo čim hitreje v štali naredili, da smo lahko šli pol k maši pa na velikonočno procesijo."
			intervals [8]:
				xmin = 37.201
				xmax = 40.116
				text = "Edino eden je po navadi doma ostal, ali jaz"
			intervals [9]:
				xmin = 40.116
				xmax = 41.88
				text = "ali pa eden mojih bratov,"
			intervals [10]:
				xmin = 41.88
				xmax = 43.545
				text = "da je mlekarju mleko dal,"
			intervals [11]:
				xmin = 43.545
				xmax = 46.992
				text = "pa zajtrk je prištimal. Ker smo pol prišli domov od maše,"
			intervals [12]:
				xmin = 46.992
				xmax = 50.509
				text = "da smo potem imeli že polno mizo in smo se pol samo še usedli"
			intervals [13]:
				xmin = 50.509
				xmax = 52.295
				text = "pa pojedli pa lepo se imeli."
			intervals [14]:
				xmin = 52.295
				xmax = 58.195
				text = "Na mizah so danes dobrote, ki imajo svoje izročilo in sporočilo."
			intervals [15]:
				xmin = 58.195
				xmax = 64.951
				text = "Ja, vsaka velikonočna jed ima, #e, svoj simbol. Rdeči pirhi predstavljajo Kristusove kaplje."
			intervals [16]:
				xmin = 64.951
				xmax = 69.725
				text = "Šunka predstavlja Kristusovo meso, telo, hren žeblje"
			intervals [17]:
				xmin = 69.725
				xmax = 70.997
				text = "in, #eem,"
			intervals [18]:
				xmin = 70.997
				xmax = 72.286
				text = "potica"
			intervals [19]:
				xmin = 72.286
				xmax = 73.384
				text = "predstavlja"
			intervals [20]:
				xmin = 73.384
				xmax = 74.608
				text = "Jezusovo krono."
			intervals [21]:
				xmin = 74.608
				xmax = 79.025
				text = "To naj bi bilo včeraj na velikonočni žegen jedi v košari, danes se pa to zaužije."
			intervals [22]:
				xmin = 79.025
				xmax = 83.668
				text = "Vaš poklic kliče, da ste tudi danes v službi."
			intervals [23]:
				xmin = 83.668
				xmax = 89.115
				text = "Ja, za tele velike praznike, predvsem za veliko noč, ki je največji krščanski praznik."
			intervals [24]:
				xmin = 89.115
				xmax = 92.611
				text = "Pravzaprav se trudim, da bi drugim naredil praznik"
			intervals [25]:
				xmin = 92.611
				xmax = 96.464
				text = "in, #eem, da bi oznanilo, ki nam ga praznik prinaša,"
			intervals [26]:
				xmin = 96.464
				xmax = 98.442
				text = "se pravi, da Kristus živi,"
			intervals [27]:
				xmin = 98.442
				xmax = 100.878
				text = "ponesel sedanjemu človeku."
			intervals [28]:
				xmin = 100.878
				xmax = 104.401
				text = "Tudi veselje do tega, da smo odrešeni in da živimo kot svobodni."
			intervals [29]:
				xmin = 104.401
				xmax = 107.022
				text = "To pa, da niste s svojimi doma ..."
			intervals [30]:
				xmin = 107.022
				xmax = 108.51
				text = "Ja, se navadiš."
			intervals [31]:
				xmin = 108.51
				xmax = 109.857
				text = "Sprejmeš v zakup."
			intervals [32]:
				xmin = 109.857
				xmax = 113.326
				text = "Pretehta ljubezen poslanstva, če tako rečem."
			intervals [33]:
				xmin = 113.326
				xmax = 117.228
				text = "Martin Golob je sejalec dobre volje in miru."
			intervals [34]:
				xmin = 117.228
				xmax = 121.277
				text = "Zato ostanite z nama na frekvencah Štajerskega vala."
			intervals [35]:
				xmin = 121.277
				xmax = 133.099
				text = ""
			intervals [36]:
				xmin = 133.099
				xmax = 137.122
				text = "Kekčeva pesem je prava asociacija za Martina Goloba."
			intervals [37]:
				xmin = 137.122
				xmax = 146.157
				text = "Pozna vas vedno več Slovencev, ker najdete kot sejalec miru in dobre volje pot do vsakega srca, tudi z mislijo:"
			intervals [38]:
				xmin = 146.157
				xmax = 150.584
				text = """Mislim, da ima Bog res smisel za humor, ustvaril je mene."""
			intervals [39]:
				xmin = 150.584
				xmax = 151.76
				text = ""
			intervals [40]:
				xmin = 151.76
				xmax = 155.738
				text = "Na splošno imam rad ljudi, nikoli se nisem ustavljal"
			intervals [41]:
				xmin = 155.738
				xmax = 162.17
				text = "pri različnostih, ampak vedno mi je bilo všeč, da sem iskal pri vsakemu človeku tisto, kar naju povezuje."
			intervals [42]:
				xmin = 162.17
				xmax = 168.243
				text = "Odraščali ste na kmetiji v vasi Velika Kostrevnica v občini Šmartno pri Litiji."
			intervals [43]:
				xmin = 168.243
				xmax = 171.346
				text = "Imate kar pet mlajših bratov."
			intervals [44]:
				xmin = 171.346
				xmax = 176.225
				text = "Mimogrede pomislim, kako je bilo mami s sedmimi moškimi pri hiši?"
			intervals [45]:
				xmin = 176.225
				xmax = 177.074
				text = "Ja, #e,"
			intervals [46]:
				xmin = 177.074
				xmax = 183.471
				text = "ona je bila kot Sneguljčica med sedmimi palčki, včasih pa tudi volk med sedmimi kozlički."
			intervals [47]:
				xmin = 183.471
				xmax = 186.82
				text = "Dejstvo pa je, da se zelo dobro zastopimo in smo zelo povezani."
			intervals [48]:
				xmin = 186.82
				xmax = 189.244
				text = "Ati pa mami zelo skupaj držita,"
			intervals [49]:
				xmin = 189.244
				xmax = 191.097
				text = "včasih pa je ati mogoče"
			intervals [50]:
				xmin = 191.097
				xmax = 192.472
				text = "za kakšno tako"
			intervals [51]:
				xmin = 192.472
				xmax = 198.075
				text = "stvar z nami fanti potegnil, recimo kar se tiče kina ali pa izbora kakšnih filmov,"
			intervals [52]:
				xmin = 198.075
				xmax = 200.321
				text = "je ati bil na naši strani."
			intervals [53]:
				xmin = 200.321
				xmax = 203.698
				text = "Zanimala sta vas novinarstvo in filozofija."
			intervals [54]:
				xmin = 203.698
				xmax = 204.107
				text = "Ja."
			intervals [55]:
				xmin = 204.107
				xmax = 208.147
				text = "Na Teološki fakulteti pa ste pristali po naključju."
			intervals [56]:
				xmin = 208.147
				xmax = 212.692
				text = "Ja, lahko tako rečem, zato ker, #eem #hhh, v četrtem letniku srednje šole"
			intervals [57]:
				xmin = 212.692
				xmax = 220.54
				text = "sem prvič v življenju doživel popravca iz, #e, angleškega jezika, ta mi je zaprla pot, da bi se lahko vpisal v prvem roku na maturo."
			intervals [58]:
				xmin = 220.54
				xmax = 222.265
				text = "Mogel sem najprej popravca narediti."
			intervals [59]:
				xmin = 222.265
				xmax = 225.403
				text = "Drugi rok mature sem naredil potem takoj, vendar"
			intervals [60]:
				xmin = 225.403
				xmax = 230.306
				text = "fakultete so bile več ali manj že zaprte, ker so se študentje vpisovali že v prvem vpisu."
			intervals [61]:
				xmin = 230.306
				xmax = 235.642
				text = "V drugem vpisu pa je bila Teološka fakulteta ena redkih še tistih, meni simpatičnih,"
			intervals [62]:
				xmin = 235.642
				xmax = 236.679
				text = "odprta,"
			intervals [63]:
				xmin = 236.679
				xmax = 239.595
				text = "in tam sem se pravzaprav srečal tako s filozofijo,"
			intervals [64]:
				xmin = 239.595
				xmax = 242.707
				text = "zdaj pa tudi sem veliko v stiku"
			intervals [65]:
				xmin = 242.707
				xmax = 244.07
				text = "z novinarji"
			intervals [66]:
				xmin = 244.07
				xmax = 247.209
				text = "in, #eem, s širjenjem besede preko medijev."
			intervals [67]:
				xmin = 247.209
				xmax = 248.28
				text = "Sklenjen krog."
			intervals [68]:
				xmin = 248.28
				xmax = 250.205
				text = "Ja, res."
			intervals [69]:
				xmin = 250.205
				xmax = 255.622
				text = "Duhovnik ste postali pri petindvajsetih letih. Eno leto ste bili kaplan v Zagorju ob Savi,"
			intervals [70]:
				xmin = 255.622
				xmax = 258.381
				text = "eno leto na Vrhniki in Zaplani."
			intervals [71]:
				xmin = 258.381
				xmax = 262.911
				text = "Pri sedemindvajsetih letih pa ste prevzeli župnijo Srednja vas v Bohinju."
			intervals [72]:
				xmin = 262.911
				xmax = 265.414
				text = "Zelo hitro se je vse odvijalo."
			intervals [73]:
				xmin = 265.414
				xmax = 270.783
				text = "Ja, saj čas gre hitro. Res pa je, da mi je bilo kar hitro zaupano župnijsko mesto,"
			intervals [74]:
				xmin = 270.783
				xmax = 273.721
				text = "verjetno majčkeno zaradi pomanjkanja duhovnikov."
			intervals [75]:
				xmin = 273.721
				xmax = 275.844
				text = "Mogoče pa tudi zaradi tega, ker sem"
			intervals [76]:
				xmin = 275.844
				xmax = 280.386
				text = "bil priden. Če že v šoli nisem preskakoval, sem pa vsaj tule."
			intervals [77]:
				xmin = 280.386
				xmax = 284.402
				text = "Razgibanemu hribovitemu okolju tam je botroval primeren avto."
			intervals [78]:
				xmin = 284.402
				xmax = 287.316
				text = "Lada Niva je bila po mnogočem unikatna."
			intervals [79]:
				xmin = 287.316
				xmax = 291.856
				text = "Imela sta poseben odnos, ki ga je sooblikoval celo njen mehanik."
			intervals [80]:
				xmin = 291.856
				xmax = 294.11
				text = "Na Dolenjskem sem kupil takrat Lado Nivo,"
			intervals [81]:
				xmin = 294.11
				xmax = 299.059
				text = "deset let staro. To je šlo vsepovsod. Za, za v hribe je to res primerno."
			intervals [82]:
				xmin = 299.059
				xmax = 301.62
				text = "Na začetku sva imela majčkeno težav."
			intervals [83]:
				xmin = 301.62
				xmax = 304.51
				text = "Bilo ga je treba marsikaj še poštimati."
			intervals [84]:
				xmin = 304.51
				xmax = 307.645
				text = "Sem imel potrpežljivega mehanika Igorja,"
			intervals [85]:
				xmin = 307.645
				xmax = 309.649
				text = "ke je, mi je rihtal"
			intervals [86]:
				xmin = 309.649
				xmax = 311.152
				text = "in mi je on tudi rekel, da,"
			intervals [87]:
				xmin = 311.152
				xmax = 317.446
				text = "#e, v življenju je treba stvari popravljati, ne pa kar menjati in, #e ... Je dal dobro mi misliti, ja."
			intervals [88]:
				xmin = 317.446
				xmax = 319.793
				text = "Potem sem ga pa po končanem"
			intervals [89]:
				xmin = 319.793
				xmax = 322.375
				text = "delovanju v Bohinju dal na dražbo."
			intervals [90]:
				xmin = 322.375
				xmax = 327.089
				text = "Za njega sem dobil pet tisoč evrov, #e, ves ta izkupiček sem dal pa na Karitas."
			intervals [91]:
				xmin = 327.089
				xmax = 331.419
				text = "Ker pa brez Lade Nive, nekako sem se res navezal, sem potem"
			intervals [92]:
				xmin = 331.419
				xmax = 332.907
				text = "po enih potih"
			intervals [93]:
				xmin = 332.907
				xmax = 336.061
				text = "dobil eno drugo. Tako da imam zdaj še vedno, pač kot drugi avto."
			intervals [94]:
				xmin = 336.061
				xmax = 346.651
				text = "Pol petih letih dela v Bohinju je dobil Martin Golob lani spomladi obvestilo o premestitvi v Grosuplje, kar je dvignilo veliko prahu."
