			intervals [10]:
				xmin = 85.025
				xmax = 87.165
				text = "ja , pa ni mus , ni …"
			intervals [11]:
				xmin = 87.165
				xmax = 92.195
				text = "Ja , pa dobro , zdaj če bojo prej korona kaj eee se zmanjšala , bojo sigurno imeli kaj prej , ne ."
