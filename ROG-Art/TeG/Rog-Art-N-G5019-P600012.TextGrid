		intervals: size = 53
			intervals [1]:
				xmin = 28.425
				xmax = 29.568
				text = "kaj pa sama pravi ?"
			intervals [2]:
				xmin = 29.568
				xmax = 41.014
				text = ""
			intervals [3]:
				xmin = 41.014
				xmax = 42.211
				text = "zaj še fprašanje …"
			intervals [4]:
				xmin = 42.211
				xmax = 44.728
				text = ""
			intervals [5]:
				xmin = 44.728
				xmax = 46.642
				text = "Še fprašanje , kolk bo"
			intervals [6]:
				xmin = 46.642
				xmax = 47.741
				text = "on mel , ne , tudi ."
			intervals [7]:
				xmin = 47.741
				xmax = 66.423
				text = ""
			intervals [8]:
				xmin = 66.423
				xmax = 66.844
				text = "ja ."
			intervals [9]:
				xmin = 66.844
				xmax = 85.025
				text = ""
			intervals [10]:
				xmin = 85.025
				xmax = 87.165
				text = "ja , pa ni mus , ni …"
			intervals [11]:
				xmin = 87.165
				xmax = 92.195
				text = "Ja , pa dobro , zaj če bojo prej korona kaj eee se zmanjšala , bojo sigurno meli kaj prej , ne ."
			intervals [12]:
				xmin = 92.195
				xmax = 107.031
				text = ""
			intervals [13]:
				xmin = 107.031
				xmax = 109.756
				text = "pa kaj zaj majo vaje normalno fsak dan , al kak ?"
			intervals [14]:
				xmin = 109.756
				xmax = 128.131
				text = ""
			intervals [15]:
				xmin = 128.131
				xmax = 129.961
				text = "ka pa ka pa pravi Nina ?"
			intervals [16]:
				xmin = 129.961
				xmax = 132.709
				text = ""
			intervals [17]:
				xmin = 132.709
				xmax = 134.295
				text = "mislim , danəs je te klicala ?"
			intervals [18]:
				xmin = 134.295
				xmax = 149.827
				text = ""
			intervals [19]:
				xmin = 149.827
				xmax = 152.499
				text = "kaj bo tak te pol čez celo novo leto tu , ne ?"
			intervals [20]:
				xmin = 152.499
				xmax = 161.916
				text = ""
			intervals [21]:
				xmin = 161.916
				xmax = 162.793
				text = "aja ?"
			intervals [22]:
				xmin = 162.793
				xmax = 169.963
				text = ""
			intervals [23]:
				xmin = 169.963
				xmax = 170.973
				text = "ka pa …"
			intervals [24]:
				xmin = 170.973
				xmax = 173.3
				text = "ka pa f službi ?"
			intervals [25]:
				xmin = 173.3
				xmax = 174.222
				text = "pri vas ?"
			intervals [26]:
				xmin = 174.222
				xmax = 193.955
				text = ""
			intervals [27]:
				xmin = 193.955
				xmax = 194.921
				text = "če pa z …"
			intervals [28]:
				xmin = 194.921
				xmax = 196.738
				text = ""
			intervals [29]:
				xmin = 196.738
				xmax = 200.607
				text = "khm Če pa so vam zaj dopust , eee , ne morte dopusta imet še al kaj ?"
			intervals [30]:
				xmin = 200.607
				xmax = 213.555
				text = ""
			intervals [31]:
				xmin = 213.555
				xmax = 219.174
				text = "kaj pa tisto zaj , ko so , ko so rekli , da vam bojo tam nekaj pregradili , kaj bote zaj meli oni"
			intervals [32]:
				xmin = 219.174
				xmax = 220.051
				text = "kovid"
			intervals [33]:
				xmin = 220.051
				xmax = 220.539
				text = "oddelek ?"
			intervals [34]:
				xmin = 220.539
				xmax = 240.958
				text = ""
			intervals [35]:
				xmin = 240.958
				xmax = 242.589
				text = "eh Nič kaj"
			intervals [36]:
				xmin = 242.589
				xmax = 244.308
