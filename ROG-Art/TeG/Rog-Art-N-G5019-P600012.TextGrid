			intervals [13]:
				xmin = 107.031
				xmax = 109.756
				text = "pa kaj zdaj imajo vaje normalno vsak dan , ali kako ?"
			intervals [14]:
				xmin = 109.756
				xmax = 128.131
				text = ""
			intervals [15]:
				xmin = 128.131
				xmax = 129.961
